<Window x:Class="DevStrider.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to DevStrider"
        Icon="pack://application:,,,/Assets/DevStrider.ico"
        Width="460"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Border Padding="28,24,28,24">
    <StackPanel>

      <TextBlock Text="DevStrider" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource MutedText}"
                 TextWrapping="Wrap"
                 Margin="0,2,0,20"
                 Text="Sign in with your company portal account. Accounts are created in the portal — there is no sign-up here."/>

      <!-- ── Credentials ────────────────────────────────────────────────── -->

      <TextBlock Text="Email"/>
      <TextBox x:Name="EmailBox"
               Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
               Tag="you@company.com"
               Margin="0,2,0,12"/>

      <TextBlock Text="Password"/>
      <PasswordBox x:Name="PasswordBox"
                   PasswordChanged="OnPasswordChanged"
                   Margin="0,2,0,4"
                   Padding="10,8"/>

      <!-- Both a wrong address and a wrong password land here with the same wording; see
           AuthService for why the form must not distinguish them. -->
      <TextBlock Text="{Binding Error}"
                 Foreground="{StaticResource Danger}"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0"
                 Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisible}}"/>

      <Button Content="Sign in"
              Command="{Binding SignInCommand}"
              IsDefault="True"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
              HorizontalAlignment="Stretch"
              Margin="0,16,0,0"
              Padding="12,9"/>

      <!-- ── Connection ─────────────────────────────────────────────────── -->

      <Border Background="{StaticResource BorderSoft}" Height="1" Margin="0,20,0,12" SnapsToDevicePixels="True"/>

      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="Database connection"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Style="{StaticResource GhostButton}"
                Command="{Binding ToggleConnectionCommand}"
                Padding="8,4">
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Show"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowConnection}" Value="True">
                    <Setter Property="Text" Value="Hide"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>
      </DockPanel>

      <StackPanel Margin="0,10,0,0"
                  Visibility="{Binding ShowConnection, Converter={StaticResource BooleanToVisibilityConverter}}">

        <TextBlock Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="The portal's PostgreSQL database. Everyone on the team uses the same one, and signing in reads your account from it."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton Content="Service URI" IsChecked="{Binding IsUriMode, Mode=TwoWay}" Margin="0,0,16,0"/>
          <RadioButton Content="Host and port" IsChecked="{Binding IsPartsMode, Mode=TwoWay}"/>
        </StackPanel>

        <!-- URI mode -->
        <StackPanel Visibility="{Binding IsUriMode, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBox Text="{Binding Connection.SharedDbUri, UpdateSourceTrigger=PropertyChanged}"
                   Tag="postgresql://user:password@host:5432/database?sslmode=require"
                   Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Parts mode -->
        <StackPanel Visibility="{Binding IsPartsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding Connection.SharedDbHost, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Host"
                     Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Connection.SharedDbPort, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Port"/>
          </Grid>
          <TextBox Text="{Binding Connection.SharedDbName, UpdateSourceTrigger=PropertyChanged}"
                   Tag="Database"
                   Margin="0,0,0,8"/>
          <TextBox Text="{Binding Connection.SharedDbUser, UpdateSourceTrigger=PropertyChanged}"
                   Tag="User"
                   Margin="0,0,0,8"/>
          <!-- Blank means "keep the saved password"; the box always renders empty, so treating
               blank as "clear it" would wipe a working credential on an unrelated edit. -->
          <PasswordBox x:Name="DbPasswordBox"
                       PasswordChanged="OnDbPasswordChanged"
                       Padding="10,8"
                       Margin="0,0,0,8"/>
        </StackPanel>

        <CheckBox Content="Require TLS"
                  IsChecked="{Binding Connection.SharedDbRequireSsl, Mode=TwoWay}"
                  Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal">
          <Button Content="Test connection"
                  Command="{Binding TestConnectionCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                  Style="{StaticResource GhostButton}"
                  Padding="12,7"
                  Margin="0,0,8,0"/>
          <Button Content="Save"
                  Command="{Binding SaveConnectionCommand}"
                  Style="{StaticResource GhostButton}"
                  Padding="12,7"/>
        </StackPanel>

        <TextBlock Text="{Binding ConnectionMessage}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding ConnectionMessage, Converter={StaticResource NonEmptyToVisible}}"/>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
