<Window x:Class="DevStrider.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to DevStrider"
        Icon="pack://application:,,,/Assets/DevStrider.ico"
        Width="420"
        SizeToContent="Height"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Border Padding="28,24,28,24">
    <StackPanel>

      <TextBlock Text="DevStrider" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource MutedText}"
                 TextWrapping="Wrap"
                 Margin="0,2,0,20"
                 Text="Sign in with your hr-system account. Accounts are created there — there is no sign-up here."/>

      <!-- ── Credentials ────────────────────────────────────────────────── -->

      <TextBlock Text="Email"/>
      <TextBox x:Name="EmailBox"
               Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
               Tag="you@company.com"
               Margin="0,2,0,12"/>

      <TextBlock Text="Password"/>
      <PasswordBox x:Name="PasswordBox"
                   PasswordChanged="OnPasswordChanged"
                   Margin="0,2,0,4"
                   Padding="10,8"/>

      <!-- Both a wrong address and a wrong password land here with the same wording; see
           AuthService for why the form must not distinguish them. -->
      <TextBlock Text="{Binding Error}"
                 Foreground="{StaticResource Danger}"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0"
                 Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisible}}"/>

      <Button Content="Sign in"
              Command="{Binding SignInCommand}"
              IsDefault="True"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
              HorizontalAlignment="Stretch"
              Margin="0,16,0,0"
              Padding="12,9"/>

    </StackPanel>
  </Border>
</Window>
