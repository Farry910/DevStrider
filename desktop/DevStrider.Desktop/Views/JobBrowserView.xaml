<UserControl x:Class="DevStrider.Desktop.Views.JobBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="0,0,12,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Click="OnNavigate" Content="Go" Margin="8,0,0,0"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
      </DockPanel>

      <!-- One tab per open application. The run drives one of them; the others are filled forms
           waiting for a person, which is why a batch no longer stops once per link. -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="0,0,0,8"
                    Visibility="{Binding ShowTabStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- One line, capped and trimmed. The status is a tooltip rather than a second line:
                 several of these sit side by side and only the selected one is being read, and a
                 posting URL can carry sixty characters of slug - which is what made these span
                 the pane. -->
            <Button Click="OnSelectTab" Tag="{Binding}" Style="{StaticResource ApplicationTab}"
                    Margin="0,0,6,6">
              <Button.ToolTip>
                <StackPanel MaxWidth="420">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Url}" Margin="0,4,0,0" FontSize="11" Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource ApplicationTabDot}"/>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                           MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Every application browser lives here at once. Only the selected one is Visible; the rest
           are Hidden, never Collapsed, because a collapsed WebView2 is arranged at zero size and a
           0x0 viewport makes every visibility test on the page report false. That is what lets the
           run keep filling a tab nobody is looking at. -->
      <Grid x:Name="BrowserHost" Grid.Row="2"/>
    </Grid>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Application Queue" Style="{StaticResource H1}"/>
        <TextBlock Text="Paste links once. After approval, DevStrider processes them in order and pauses before every final submission."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Job links" FontWeight="SemiBold"/>
            <TextBox Text="{Binding QueueLinksInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding QueueInputReadOnly}"
                     AcceptsReturn="True" Height="78" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" Tag="Paste one or many job URLs"/>
            <WrapPanel>
              <Button Command="{Binding AddLinksToQueueCommand}" Content="Add links" Margin="0,0,8,8"
                      Visibility="{Binding IsAutomaticQueueIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding StartAutomaticQueueCommand}" Content="Approve &amp; start automatic flow" Margin="0,0,8,8"
                      Visibility="{Binding IsAutomaticQueueIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding IsAutomaticQueueRunning, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding StopAutomaticQueueCommand}" Content="Stop automation" Margin="0,0,8,8" Style="{StaticResource GhostButton}"
                      Visibility="{Binding IsAutomaticQueueRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <!--
                Always available, including mid-run: dropping the rest of the backlog is exactly the
                thing you want while a run is going badly. Links currently open keep their place.
              -->
              <Button Command="{Binding ClearQueuedLinksCommand}" Content="Clear list" Margin="0,0,8,8"
                      Style="{StaticResource GhostButton}"
                      ToolTip="Removes every queued link. Links open for review or being worked on right now are kept."/>
            </WrapPanel>
            <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <DataGrid ItemsSource="{Binding JobQueue}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="150" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/>
                <DataGridTextColumn Header="Job link" Binding="{Binding Url}" Width="*"/>
                <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="48"/>
                <DataGridTextColumn Header="Last error" Binding="{Binding Error}" Width="220"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasFailedLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Failed links" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8">
              <Run Text="{Binding FailedCount, Mode=OneWay}"/>
              <Run Text="link(s) failed and were collected here. Requeue them once the cause is cleared, copy them out, or drop them from the queue."/>
            </TextBlock>
            <DataGrid ItemsSource="{Binding FailedLinks}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" MaxHeight="140" Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Job link" Binding="{Binding Url}" Width="*"/>
                <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="48"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="260"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel>
              <Button Command="{Binding RequeueFailedLinksCommand}" Content="Requeue failed links" Margin="0,0,8,8"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding CopyFailedLinksCommand}" Content="Copy failed links" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Command="{Binding ClearFailedLinksCommand}" Content="Remove from queue" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Current application" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentStep}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
            <TextBlock Text="{Binding AdapterName}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <!-- The manual description pass. Links the automatic run could not read a description
             from are gathered here and worked through together once it finishes, so one awkward
             page never stalls a batch. Selecting on the page is the fast path; pasting is for
             postings that block selection. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding NeedsJobDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Job description needed" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ManualJobDescriptionProgress}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="Highlight the description on the page, then Use selection. The rest of the flow runs as usual."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <WrapPanel>
              <Button Click="OnUseSelectedJobDescription" Content="Use selection" Margin="0,0,8,8"/>
              <Button Command="{Binding SkipManualJobDescriptionCommand}" Content="Skip this link"
                      Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="Or paste it" Style="{StaticResource MutedText}" Margin="0,4,0,4"/>
            <TextBox Text="{Binding FallbackJobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <Button Click="OnUsePastedJobDescription" Content="Use pasted text" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding IsReadyForReview, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Review required" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ReviewBacklogSummary}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding SelectedTab.Summary}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Check the form in this tab and submit it on the site, then mark it here. The queue keeps working in the other tabs meanwhile."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <WrapPanel>
              <Button Command="{Binding MarkSubmittedAndContinueCommand}" Content="Mark submitted &amp; close" Margin="0,0,8,8"/>
              <Button Command="{Binding CloseSelectedTabCommand}" Content="Close without submitting" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Expander Header="Manual and recovery tools" IsExpanded="False"
                  Visibility="{Binding ShowManualTools, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel Margin="0,8,0,0">
            <WrapPanel>
              <Button Click="OnStartBid" Content="Run current page flow" Margin="0,0,8,8"/>
              <Button Click="OnExtract" Content="Extract visible text" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Command="{Binding OpenNextQueuedLinkCommand}" Content="Open next manually" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Command="{Binding RetryCurrentCommand}" Content="Retry current" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="Extracted JD" FontWeight="SemiBold"/>
            <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6"/>
            <Button Command="{Binding CopyExtractedJobDescriptionCommand}" Content="Copy JD" HorizontalAlignment="Left" Style="{StaticResource GhostButton}"/>
            <TextBlock Text="Application answers" FontWeight="SemiBold" Margin="0,14,0,2"/>
            <WrapPanel>
              <Button Click="OnExtractQuestions" Content="Extract questions" Margin="0,0,8,8"/>
              <Button Command="{Binding CopyQuestionsForChatGptCommand}" Content="Copy question prompt" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Click="OnFill" Content="Fill fields" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBox Text="{Binding CurrentAnswersJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     Height="100" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Resume file" FontWeight="SemiBold" Margin="0,14,0,2"/>
            <TextBox Text="{Binding SelectedResumePath}" IsReadOnly="True"/>
            <WrapPanel Margin="0,8,0,0">
              <Button Click="OnChooseResume" Content="Choose resume..." Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Click="OnUploadResume" Content="Upload resume" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="Personal reference data sent to ChatGPT (read-only)" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <TextBlock Text="Edit these in Profiles → Personal info. Shown here so you can see exactly what ChatGPT was given when an answer looks wrong."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SavedAnswersJson}" IsReadOnly="True" AcceptsReturn="True"
                     Height="100" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
