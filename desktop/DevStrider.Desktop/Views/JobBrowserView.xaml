<UserControl x:Class="DevStrider.Desktop.Views.JobBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="0,0,12,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Click="OnNavigate" Content="Go" Margin="8,0,0,0"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
      </DockPanel>

      <!-- One tab per open application. The run drives one of them; the others are filled forms
           waiting for a person, which is why a batch no longer stops once per link. -->
      <ScrollViewer Grid.Row="1" Margin="0,0,0,6"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    Visibility="{Binding ShowTabStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- One line, capped and trimmed. The status is a tooltip rather than a second line:
                 several of these sit side by side and only the selected one is being read, and a
                 posting URL can carry sixty characters of slug - which is what made these span
                 the pane. -->
            <Button Click="OnSelectTab" Tag="{Binding}" Style="{StaticResource ApplicationTab}"
                    Margin="0,0,4,0" Padding="8,3">
              <!-- Ctrl+click opens this, and so does a right-click. A modifier that acted on its own
                   would put "remove this application" one slip away from a plain tab switch, so the
                   gesture opens the choice rather than making it. -->
              <Button.ContextMenu>
                <ContextMenu>
                  <!-- Marking submitted closes the tab too: a submitted application left in the
                       review list is a thing to read and dismiss that carries no decision. Remove
                       stays for the other case — done with it, but it did not go through. -->
                  <MenuItem Header="Mark submitted and close" Click="OnTabMarkSubmitted"/>
                  <MenuItem Header="Remove from the list" Click="OnTabRemove"/>
                </ContextMenu>
              </Button.ContextMenu>
              <Button.ToolTip>
                <StackPanel MaxWidth="420">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Url}" Margin="0,4,0,0" FontSize="11" Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Button.ToolTip>
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource ApplicationTabDot}"/>
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                           MaxWidth="88" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <!-- Every application browser lives here at once. Only the selected one is Visible; the rest
           are Hidden, never Collapsed, because a collapsed WebView2 is arranged at zero size and a
           0x0 viewport makes every visibility test on the page report false. That is what lets the
           run keep filling a tab nobody is looking at. -->
      <Grid x:Name="BrowserHost" Grid.Row="2"/>

      <!--
        The review actions, pinned bottom-left under the browser.

        Deliberately a reserved strip rather than a button floating over the page: the WPF WebView2
        is HwndHost-based, so the browser paints its own child window and any WPF content placed on
        top of it is simply not drawn. A floating button there would be an invisible button. This
        sits in the same corner and is always reachable, which is what the floating one was for.
      -->
      <Border Grid.Row="3" Margin="0,6,0,0" Padding="0"
              Visibility="{Binding IsReadyForReview, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Command="{Binding MarkSubmittedAndContinueCommand}"
                  Content="Mark submitted &amp; close" Margin="0,0,8,0"
                  ToolTip="Records this application as applied and closes its tab, freeing the slot for the queue."/>
          <Button Command="{Binding CloseSelectedTabCommand}" Content="Close without submitting"
                  Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding ReviewBacklogSummary}" Style="{StaticResource MutedText}"
                     FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Auto bidding" Style="{StaticResource H1}"/>
        <TextBlock Text="Paste links once, grouped by job board. A run navigates, reads the description, writes the resume, fills the form and parks it for review — Submit is yours to press unless you turn that off in Settings."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Job links" FontWeight="SemiBold"/>
            <TextBox Text="{Binding QueueLinksInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding QueueInputReadOnly}"
                     AcceptsReturn="True" Height="78" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" Tag="Paste one or many job URLs"/>
            <WrapPanel>
              <Button Command="{Binding AddLinksToQueueCommand}" Content="Add links" Margin="0,0,8,8"
                      Visibility="{Binding IsAutomaticQueueIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding StartAutomaticQueueCommand}" Content="Approve &amp; start automatic flow" Margin="0,0,8,8"
                      Visibility="{Binding IsAutomaticQueueIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding IsAutomaticQueueRunning, Converter={StaticResource InverseBoolean}}"/>
              <!-- For a board that e-mails a code: apply to one, then stop with its tab open rather
                   than burying it under the next five applications. -->
              <Button Command="{Binding StartSingleLinkCommand}" Content="Apply to one, then stop" Margin="0,0,8,8"
                      Style="{StaticResource GhostButton}"
                      Visibility="{Binding IsAutomaticQueueIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding IsAutomaticQueueRunning, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding StopAutomaticQueueCommand}" Content="Stop automation" Margin="0,0,8,8" Style="{StaticResource GhostButton}"
                      Visibility="{Binding IsAutomaticQueueRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <!--
                Always available, including mid-run: dropping the rest of the backlog is exactly the
                thing you want while a run is going badly. Links currently open keep their place.
              -->
              <Button Command="{Binding ClearQueuedLinksCommand}" Content="Clear list" Margin="0,0,8,8"
                      Style="{StaticResource GhostButton}"
                      ToolTip="Removes every queued link. Links open for review or being worked on right now are kept."/>
            </WrapPanel>
            <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <!--
              Links grouped by the board they are on. Every posting on one site is the same form
              behind the same adapter, so they succeed together and they fail together — which is
              what makes the grouping worth looking at before a run rather than after. Six Deel
              links you already know defeat the generic adapter are six failures you can decline to
              pay for, in one action.
            -->
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,8,0,6"/>
            <WrapPanel Visibility="{Binding HasQueuedLinks, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,0,0,6">
              <Button Command="{Binding SelectAllLinksCommand}" Content="Tick all"
                      Style="{StaticResource GhostButton}" Margin="0,0,6,6"/>
              <Button Command="{Binding ClearLinkSelectionCommand}" Content="Untick all"
                      Style="{StaticResource GhostButton}" Margin="0,0,6,6"/>
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding LinkGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Collapsed by default: the heading is the useful part - the board and how
                       many links are on it - and that is what you scan before a run. Opening one
                       is for when you want to see which postings they actually are. -->
                  <Expander IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                      <DockPanel LastChildFill="False" Width="370">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Move all to Manual Bidding"
                                Style="{StaticResource GhostButton}" FontSize="11" Padding="6,2"
                                Command="{Binding DataContext.MoveGroupToManualCommand,
                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                ToolTip="These are one form behind one adapter. If one defeats the automation the rest will too, so they move together."/>
                      </DockPanel>
                    </Expander.Header>
                    <StackPanel Margin="14,4,0,6">
                      <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                                 FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,0,0,3" LastChildFill="True">
                              <CheckBox DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Ticked links are the ones an automatic run takes."/>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Attempts}" FontSize="10"
                                         Opacity="0.55" VerticalAlignment="Center" Margin="6,0,0,0"
                                         ToolTip="Attempts so far"/>
                              <TextBlock Text="{Binding Url}" FontSize="11" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasNoLinkGroups, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Text="No links queued. Paste some above; they will be grouped by job board."/>

            <!-- Links that are not queued any more still need somewhere to be read. -->
            <Expander Header="Everything in the queue" IsExpanded="False" Margin="0,8,0,0">
              <DataGrid ItemsSource="{Binding JobQueue}" SelectedItem="{Binding SelectedQueueItem}"
                        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        Height="150" Margin="0,4,0,0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/>
                  <DataGridTextColumn Header="Job link" Binding="{Binding Url}" Width="*"/>
                  <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="48"/>
                  <DataGridTextColumn Header="Last error" Binding="{Binding Error}" Width="220"/>
                </DataGrid.Columns>
              </DataGrid>
            </Expander>
          </StackPanel>
        </Border>

      <!--
        The manual bid board. For boards with no adapter behind them, where hunting for the form is
        a guess and filling it is a worse one.

        A board, not one open bid at a time: several sit here at once, each with its own tab and its
        own form, and their resumes are written one after another behind them. Generation is serial
        because there is one ChatGPT browser per lane — which is exactly why this is a list you can
        watch rather than a single panel that makes you wait.
      -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"
              Visibility="{Binding HasManualBids, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Manual bids — these pages are yours" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ManualBoardSummary}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" Margin="0,4,0,6"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="The app never clicks, fills or submits on these. Paste each description, queue its resume, and keep filling forms while they are written — one at a time, in order."/>

          <ItemsControl ItemsSource="{Binding ManualBoard}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource CardBorder}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11"
                                 Opacity="0.75" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#C0392B"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisible}}"/>

                    <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                             Tag="paste this posting's job description"/>

                    <WrapPanel>
                      <Button Content="Open its tab" Margin="0,0,6,0"
                              Command="{Binding DataContext.ShowManualBidCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Queue resume" Margin="0,0,6,0"
                              Command="{Binding DataContext.QueueManualResumeCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"
                              ToolTip="Generates in the background. The form does not have to be open — a description is all a resume needs."/>
                      <Button Content="Attach resume" Margin="0,0,6,0"
                              Command="{Binding DataContext.AttachManualResumeCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"
                              ToolTip="Puts the file into this tab's upload field. Not automatic — a form can rerender when its file input changes, and that is not something to do underneath you mid-field."/>
                      <Button Content="Show file" Margin="0,0,6,0"
                              Command="{Binding DataContext.RevealManualResumeCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="I submitted this" Margin="0,0,6,0"
                              Command="{Binding DataContext.MarkManualBidSubmittedCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"
                              ToolTip="Records the bid as applied. The app cannot see you press submit on a page it is not driving, so it is told."/>
                      <Button Content="Close"
                              Command="{Binding DataContext.CancelManualBidCommand,
                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"
                              ToolTip="Takes it off the board without submitting. The link goes back in the automatic queue."/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!--
        Links whose description could not be read. Paste one in for any of them, at any time, and
        the link goes back in the queue to run like any other — rather than waiting for the manual
        pass to reach it in its own order.
      -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"
              Visibility="{Binding HasNeedsJdItems, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Needs a job description" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding JdTargetSummary}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" Margin="0,4,0,6"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="Open the posting, copy the description, and paste it here. The link is queued again with that text and never reads the page for itself."/>
          <ListBox ItemsSource="{Binding NeedsJdItems}" SelectedItem="{Binding JdTarget}"
                   MaxHeight="90" Margin="0,0,0,6" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox Text="{Binding PastedJobDescription, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="120" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                   Tag="paste the job description"/>
          <Button Command="{Binding ApplyPastedJobDescriptionCommand}"
                  Content="Use this description and queue the link" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!--
        Verification codes. Some sites confirm the application and then e-mail a code, which arrives
        minutes later with the run several links further on. The queue does not wait for it: the
        application parks here with its tab still open, and the codes are pasted in as they arrive.
        One box, aimed by default at whichever has been waiting longest, so pasting them in the order
        the e-mails land needs no aiming at all — but the list is there because the e-mails do not
        always arrive in the order the applications went out.
      -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"
              Visibility="{Binding HasAwaitingCode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Needs a verification code" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CodeTargetSummary}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" Margin="0,4,0,8"/>
          <ListBox ItemsSource="{Binding AwaitingCodeItems}" SelectedItem="{Binding CodeTarget}"
                   MaxHeight="110" Margin="0,0,0,8" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                     Width="150" Margin="0,0,8,0" FontFamily="{StaticResource UiFontMono}"
                     Tag="paste the code">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SubmitVerificationCodeCommand}"/>
              </TextBox.InputBindings>
            </TextBox>
            <Button Command="{Binding SubmitVerificationCodeCommand}" Content="Enter code"/>
          </StackPanel>
        </StackPanel>
      </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding HasFailedLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Failed links" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8">
              <Run Text="{Binding FailedCount, Mode=OneWay}"/>
              <Run Text="link(s) failed and were collected here. Requeue them once the cause is cleared, copy them out, or drop them from the queue."/>
            </TextBlock>
            <DataGrid ItemsSource="{Binding FailedLinks}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" MaxHeight="140" Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Job link" Binding="{Binding Url}" Width="*"/>
                <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="48"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="260"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel>
              <Button Command="{Binding RequeueFailedLinksCommand}" Content="Requeue failed links" Margin="0,0,8,8"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
              <Button Command="{Binding CopyFailedLinksCommand}" Content="Copy failed links" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
              <Button Command="{Binding ClearFailedLinksCommand}" Content="Remove from queue" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      IsEnabled="{Binding QueueInputReadOnly, Converter={StaticResource InverseBoolean}}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Current application" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentStep}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
            <TextBlock Text="{Binding AdapterName}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <!-- The manual description pass. Links the automatic run could not read a description
             from are gathered here and worked through together once it finishes, so one awkward
             page never stalls a batch. Selecting on the page is the fast path; pasting is for
             postings that block selection. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding NeedsJobDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Job description needed" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ManualJobDescriptionProgress}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="Highlight the description on the page, then Use selection. The rest of the flow runs as usual."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <WrapPanel>
              <Button Click="OnUseSelectedJobDescription" Content="Use selection" Margin="0,0,8,8"/>
              <Button Command="{Binding SkipManualJobDescriptionCommand}" Content="Skip this link"
                      Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="Or paste it" Style="{StaticResource MutedText}" Margin="0,4,0,4"/>
            <TextBox Text="{Binding FallbackJobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <Button Click="OnUsePastedJobDescription" Content="Use pasted text" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding IsReadyForReview, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Review required" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ReviewBacklogSummary}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding SelectedTab.Summary}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Check the form in this tab and submit it on the site, then mark it done with the buttons under the browser. The queue keeps working in the other tabs meanwhile."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
