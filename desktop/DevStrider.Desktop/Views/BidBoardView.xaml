<UserControl x:Class="DevStrider.Desktop.Views.BidBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel LastChildFill="True">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Bid board" Style="{StaticResource H1}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding UseCustomRange, Mode=TwoWay}"
                  Content="Range"
                  VerticalAlignment="Center"
                  ToolTip="Use a date range instead of a single day"
                  Margin="0,0,8,0"/>
        <DatePicker SelectedDate="{Binding SelectedDay, Mode=TwoWay}" VerticalAlignment="Center">
          <DatePicker.Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding UseCustomRange}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DatePicker.Style>
        </DatePicker>
        <StackPanel Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding UseCustomRange}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" VerticalAlignment="Center"/>
          <TextBlock Text="→" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Muted}"/>
          <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0" Foreground="{StaticResource Muted}"/>
      <Button Grid.Column="3"
              Command="{Binding ReloadCommand}"
              Style="{StaticResource IconButton}"
              ToolTip="Refresh">
        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"/>
      </Button>
    </Grid>

    <!-- Record a bid from the folder name the macro produced. That folder is named with the
         fast-feed line, so pasting it here is the whole entry step. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource FlatCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Text="{Binding NewFastFeed, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,8,0"
                 Tag="Fast feed — paste the folder name: UID, Company, Role, Stack1, Stack2">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding AddFastFeedCommand}"/>
          </TextBox.InputBindings>
        </TextBox>
        <Button Grid.Column="1" Command="{Binding AddFastFeedCommand}" ToolTip="Record this bid" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Add bid" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <!-- Bulk entry from the macro's output folders. See FolderBidDialog. -->
        <Button Grid.Column="2"
                Click="OnImportFolderClick"
                Style="{StaticResource GhostButton}"
                ToolTip="Record a day's bids from a folder of resume folders">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="From folder…" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Queued-bid indicator. Only present when something is waiting, so it reads as information
         rather than as a permanent widget. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource SurfaceAlt}"
            CornerRadius="4"
            Padding="10,6"
            Margin="0,0,0,8"
            Visibility="{Binding PendingDisplay, Converter={StaticResource NonEmptyToVisible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Command="{Binding SubmitPendingCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                Style="{StaticResource GhostButton}"
                Padding="10,3">
          <TextBlock Text="Submit now" FontSize="11"/>
        </Button>
        <TextBlock Text="{Binding PendingDisplay}"
                   Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <!-- Bulk-actions toolbar — slides in when ≥1 row is selected in the grid below.
         Reads SelectedItems off the grid directly so the VM stays free of WPF types. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PrimarySoft}"
            CornerRadius="6"
            Padding="12,6"
            Margin="0,0,0,8"
            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center">
          <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
          <Run Text=" selected"/>
        </TextBlock>
        <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center"/>
        <TextBlock Text="Set status to" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox SelectedItem="{Binding BulkStatus, Mode=TwoWay}"
                  ItemsSource="{Binding AllBidStatuses}"
                  MinWidth="140"
                  VerticalAlignment="Center"/>
        <Button Command="{Binding BulkApplyStatusCommand}"
                CommandParameter="{Binding ElementName=BidGrid, Path=SelectedItems}"
                Margin="8,0,0,0"
                Style="{StaticResource GhostButton}">
          Apply
        </Button>
        <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center"/>
        <Button Command="{Binding BulkDeleteCommand}"
                CommandParameter="{Binding ElementName=BidGrid, Path=SelectedItems}"
                Style="{StaticResource GhostButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource Danger}"/>
            <TextBlock Text="Delete" VerticalAlignment="Center"
                       Foreground="{StaticResource Danger}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Rows -->
    <DataGrid x:Name="BidGrid"
              ItemsSource="{Binding Rows}"
              SelectionUnit="FullRow"
              SelectionMode="Extended"
              SelectionChanged="OnBidGridSelectionChanged">
      <DataGrid.Columns>
        <!--
          Duplicate / interview warnings. The two duplicate kinds are deliberately distinct:
          red "!" means you bid this exact posting before, amber means a different listing for
          what looks like the same job, and the interview flag is its own colour again. The
          tooltip names the earlier bid and its date.
        -->
        <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                         FontSize="13"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         ToolTip="{Binding WarningTooltip}"
                         ToolTipService.ShowDuration="20000"
                         Text="">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <!-- Exact repeat — strongest signal, red. -->
                      <DataTrigger Binding="{Binding WarningKind}" Value="url">
                        <Setter Property="Text" Value="&#xEA39;"/>
                        <Setter Property="Foreground" Value="#F44336"/>
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <!-- Already interviewing at this company. -->
                      <DataTrigger Binding="{Binding WarningKind}" Value="interview">
                        <Setter Property="Text" Value="&#xE8BD;"/>
                        <Setter Property="Foreground" Value="#42A5F5"/>
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <!-- Same company+role from a different listing — softer, amber. -->
                      <DataTrigger Binding="{Binding WarningKind}" Value="role">
                        <Setter Property="Text" Value="&#xE7BA;"/>
                        <Setter Property="Foreground" Value="#FFC107"/>
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="URL" Width="2*" SortMemberPath="Bid.Url">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- Clickable hyperlink: opens the URL in the OS default browser via the
                   Click handler in code-behind (ProcessStartInfo + UseShellExecute=true).
                   Bound via Hyperlink.Tag so the handler can read the URL without
                   pulling in a separate value converter. -->
              <TextBlock VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis">
                <Hyperlink Click="OnUrlClick"
                           Tag="{Binding Bid.Url}"
                           Foreground="{StaticResource Primary}">
                  <Run Text="{Binding Bid.Url, Mode=OneWay}"/>
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Bid.ResumeId is the resume's UID (e.g. "7mK92"), read off the fast-feed line and
             also the prefix of the output folder the Word macro writes into. Carried onto the
             Interview row at scheduling time so a round can be traced back to what was sent. -->
        <DataGridTextColumn Header="UID"        Binding="{Binding Bid.ResumeId}" Width="80"/>
        <DataGridTextColumn Header="Company"    Binding="{Binding Bid.Company}" Width="*"/>
        <DataGridTextColumn Header="Role"       Binding="{Binding Bid.Role}" Width="*"/>
        <DataGridComboBoxColumn Header="Status"
                                SelectedItemBinding="{Binding Bid.Status}"
                                Width="120">
          <DataGridComboBoxColumn.ItemsSource>
            <x:Array Type="{x:Type System:String}" xmlns:System="clr-namespace:System;assembly=mscorlib">
              <System:String>draft</System:String>
              <System:String>applied</System:String>
              <System:String>phone_screening</System:String>
              <System:String>interview</System:String>
              <System:String>offer</System:String>
              <System:String>rejected</System:String>
              <System:String>withdrawn</System:String>
              <System:String>accepted</System:String>
            </x:Array>
          </DataGridComboBoxColumn.ItemsSource>
        </DataGridComboBoxColumn>
        <DataGridTextColumn Header="Origin"     Binding="{Binding Bid.Origin}" Width="120"/>
        <DataGridTextColumn Header="Created"    Binding="{Binding Bid.CreatedAt, StringFormat='{}{0:MMM dd HH:mm}'}" Width="120"/>
        <DataGridTemplateColumn Header="Actions" Width="190" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <!-- Fast-feed entry: opens a popup with a single text box. Code-behind
                     calls the VM's ApplyFastFeedCommand with the typed string. -->
                <Button Click="OnFastFeedClick"
                        Tag="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Apply fast-feed line (UID, Company, Role, Stack1, …)"
                        Content="&#xE756;"/>
                <!-- JD viewer: opens a modal with this row's job description (bid JD takes
                     precedence over the link's shared JD). -->
                <Button Click="OnViewJdClick"
                        Tag="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                        Style="{StaticResource IconButton}"
                        ToolTip="View job description"
                        Content="&#xE7C3;"/>
                <!-- Schedule an interview straight off this bid. Inherits ResumeId + JD. -->
                <Button Click="OnScheduleInterviewClick"
                        Tag="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Schedule interview from this bid"
                        Content="&#xE787;"/>
                <Button Command="{Binding DataContext.SaveBidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Save row"
                        Content="&#xE74E;"/>
                <Button Command="{Binding DataContext.DeleteBidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                        Style="{StaticResource DangerIconButton}"
                        ToolTip="Delete bid"
                        Content="&#xE74D;"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
