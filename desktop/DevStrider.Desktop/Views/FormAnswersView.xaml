<UserControl x:Class="DevStrider.Desktop.Views.FormAnswersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="0,12,0,0">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Answers reused across every job site. ChatGPT proposes them from your profile and generated resume; approving one means you stand behind it. A blank answer is a question nobody has answered yet."
                 Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding Coverage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Command="{Binding ApproveAllCommand}" Content="Approve all ChatGPT answers" Margin="0,0,8,0"
                    IsEnabled="{Binding HasPending}"/>
            <Button Command="{Binding LoadCommand}" Content="Refresh" Style="{StaticResource GhostButton}"/>
          </WrapPanel>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Answers}" AutoGenerateColumns="False" CanUserAddRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Job site" Binding="{Binding LastSite}" Width="150" IsReadOnly="True"/>
        <DataGridTextColumn Header="Field name" Binding="{Binding FieldName}" Width="140" IsReadOnly="True"/>
        <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="2*" IsReadOnly="True"/>
        <DataGridTemplateColumn Header="Answer" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                       Background="Transparent" VerticalAlignment="Center"
                       Tag="Type your answer"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" IsReadOnly="True"/>
        <DataGridTemplateColumn Header="Approved" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding IsApproved}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Seen" Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SeenCount}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <WrapPanel>
                <Button Content="Save"
                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,2"/>
                <Button Content="Approve" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,2"/>
                <Button Content="Remove" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" Padding="8,2"/>
              </WrapPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
