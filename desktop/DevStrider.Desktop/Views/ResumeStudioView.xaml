<UserControl x:Class="DevStrider.Desktop.Views.ResumeStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="390"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel>
        <TextBlock Text="Resume Studio" Style="{StaticResource H1}"/>
        <TextBlock Text="Generate a resume directly from a recruiter-provided job description. Queued job applications use this same engine automatically."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ResumeChatProgress}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Recruiter resume request" FontWeight="SemiBold"/>
            <TextBlock Text="Optional label" Margin="0,8,0,2"/>
            <TextBox Text="{Binding RecruiterLabel, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding InputsReadOnly}" Tag="Company or role"/>
            <TextBlock Text="Job description" Margin="0,10,0,2"/>
            <TextBox Text="{Binding RecruiterJobDescription, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding InputsReadOnly}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="260"
                     VerticalScrollBarVisibility="Auto"/>
            <Button Command="{Binding GenerateRecruiterResumeCommand}"
                    Content="Generate resume"
                    IsEnabled="{Binding IsAutomationRunning, Converter={StaticResource InverseBoolean}}"
                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <Expander Header="Manual recovery" IsExpanded="{Binding ShowManualRecovery}" Margin="0,0,0,10">
          <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="Use these controls if ChatGPT UI automation or Word generation needs manual help."
                         Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button Command="{Binding StartFreshChatCommand}" Content="Start fresh chat" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                <Button Command="{Binding CopyPreparedPromptCommand}" Content="Copy prepared prompt" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                <Button Command="{Binding FinishFromClipboardCommand}" Content="Use reply from clipboard" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
                <Button Command="{Binding RetryWordMacroCommand}" Content="Retry Word" Margin="0,0,8,8" Style="{StaticResource GhostButton}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Expander>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="{StaticResource BorderSoft}"/>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="12,10">
          <TextBlock Text="ChatGPT - always loaded" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <wv2:WebView2 x:Name="ChatGptBrowser" Grid.Row="1"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
