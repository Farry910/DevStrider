<UserControl x:Class="DevStrider.Desktop.Views.ResumeStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="430"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel>
        <TextBlock Text="Resume Studio" Style="{StaticResource H1}"/>
        <TextBlock Text="Use one signed-in ChatGPT conversation: paste the profile prompt once, then paste each job description into that same conversation." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SessionProgress}" Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding StartSessionCommand}" Content="Start session" Margin="0,0,8,0"/>
              <Button Command="{Binding EndSessionCommand}" Content="End session" Style="{StaticResource GhostButton}"/>
            </StackPanel>
            <TextBlock Text="Resumes per session" Margin="0,12,0,2"/>
            <TextBox Text="{Binding GenerationLimit, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <CheckBox Content="Automatically generate Word resume after validation" IsChecked="{Binding AutomaticallyRunWordMacro, Mode=TwoWay}" Margin="0,10,0,0"/>
            <TextBlock Text="This never submits a job application." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="22,2,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Job" FontWeight="SemiBold"/>
            <TextBlock Text="Job URL (optional)" Margin="0,8,0,2"/>
            <TextBox Text="{Binding JobUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://…"/>
            <TextBlock Text="Job description" Margin="0,10,0,2"/>
            <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto"/>
            <Button Command="{Binding CopyJobDescriptionCommand}" Content="Copy JD for ChatGPT" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ChatGPT reply" FontWeight="SemiBold"/>
            <TextBlock Text="Copy the complete answer from ChatGPT and paste it here. The trailing fast-feed metadata remains supported." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,6"/>
            <TextBox Text="{Binding GeneratedResume, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Command="{Binding SaveDraftCommand}" Content="Save draft" Margin="0,0,8,0"/>
              <Button Command="{Binding RunWordMacroCommand}" Content="Generate Word resume" Style="{StaticResource GhostButton}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="{StaticResource BorderSoft}"/>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="12,10">
          <Button DockPanel.Dock="Right" Click="OnOpenChatGpt" Content="Open ChatGPT" Style="{StaticResource GhostButton}"/>
          <TextBlock Text="ChatGPT" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <wv2:WebView2 x:Name="ChatGptBrowser" Grid.Row="1" Source="https://chatgpt.com/"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
