<UserControl x:Class="DevStrider.Desktop.Views.AssistedAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Job Operations" Style="{StaticResource H1}"/>
      <TextBlock Text="Ask signed-in ChatGPT to review the Gmail/Calendar connections you authorized. DevStrider validates the returned proposals; every local change still requires your selection." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel Margin="0,0,0,8">
            <Button Command="{Binding CopyInboxPromptCommand}" Content="Check inbox" Margin="0,0,8,8"/>
            <Button Command="{Binding CopyCalendarPromptCommand}" Content="Check calendar" Margin="0,0,8,8"/>
            <Button Command="{Binding CopyFullReviewPromptCommand}" Content="Review both" Margin="0,0,8,8"/>
            <Button Command="{Binding ReviewCommand}" Content="Review pasted proposals" Style="{StaticResource GhostButton}"/>
          </WrapPanel>
          <TextBox Text="{Binding ProposalJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Tag="Paste the JSON answer from ChatGPT here"/>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Actions}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,8">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Apply" Width="55">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanApply}" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Action" Binding="{Binding Type}" Width="150"/>
        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
        <DataGridTextColumn Header="New status" Binding="{Binding DesiredStatus}" Width="105"/>
        <DataGridTextColumn Header="Match" Binding="{Binding MatchMessage}" Width="190"/>
        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*"/>
        <DataGridTextColumn Header="Suggestion" Binding="{Binding Suggestion}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button DockPanel.Dock="Bottom" Command="{Binding ApplySelectedCommand}" Content="Apply selected actions" HorizontalAlignment="Left"/>
  </DockPanel>
</UserControl>
