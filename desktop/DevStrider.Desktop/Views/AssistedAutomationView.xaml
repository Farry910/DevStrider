<UserControl x:Class="DevStrider.Desktop.Views.AssistedAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Job Operations" Style="{StaticResource H1}"/>
      <TextBlock Text="Assisted automation: ChatGPT reviews the Gmail/Calendar connections you authorized; you paste its structured proposals here and explicitly choose what DevStrider applies." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding CopyReviewPromptCommand}" Content="Copy ChatGPT review prompt" Margin="0,0,8,0"/>
            <Button Command="{Binding ReviewCommand}" Content="Review pasted proposals" Style="{StaticResource GhostButton}"/>
          </StackPanel>
          <TextBox Text="{Binding ProposalJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Tag="Paste the JSON answer from ChatGPT here"/>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Actions}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,8">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IsSelected, Mode=TwoWay}" Width="55"/>
        <DataGridTextColumn Header="Action" Binding="{Binding Type}" Width="150"/>
        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
        <DataGridTextColumn Header="Match" Binding="{Binding MatchMessage}" Width="190"/>
        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button DockPanel.Dock="Bottom" Command="{Binding ApplySelectedCommand}" Content="Apply selected actions" HorizontalAlignment="Left"/>
  </DockPanel>
</UserControl>
