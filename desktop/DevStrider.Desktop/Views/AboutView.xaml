<UserControl x:Class="DevStrider.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Padding keeps the scrollbar off the text: below ~900px the content area is narrower than
       the MaxWidth below, so the column runs right up to where the bar appears. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="About" Style="{StaticResource H1}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="DevStrider" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Background="{StaticResource SurfaceAlt}"
                    CornerRadius="3"
                    Padding="6,1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding Version}" Foreground="{StaticResource Muted}" FontSize="11"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Data store" Foreground="{StaticResource Muted}" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataLocation}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Local listener" Foreground="{StaticResource Muted}" Margin="0,0,12,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ListenerHint}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Shared database" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SharedClusterLocation}" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="How to use DevStrider" FontWeight="SemiBold" Margin="0,0,0,10"/>

          <TextBlock Text="1 · Prepare each profile's Word template" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="Every profile has its own .docm — that file holds that person's layout, their bookmarks, and their macro. The document must contain nine bookmarks, which is where the generated text lands:"/>
          <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
            <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Text="bmTitle   bmSummary   bmSkills&#x0A;bmSubtitle1   bmExperience1&#x0A;bmSubtitle2   bmExperience2&#x0A;bmSubtitle3   bmExperience3"/>
          </Border>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="The macro is called headless over COM with the resume text as its single argument, so its signature must take one String. It must NOT read the clipboard — yours stays free while a resume is generating:"/>
          <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
            <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Text="Sub UpdateResumeAndSwitchOriginal(ByVal ClipText As String)"/>
          </Border>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="The macro should fill the bookmarks from the [Section]: labels in that text, save its .docx and .pdf, and finish with Application.Quit — DevStrider treats Word closing as the signal that the run succeeded. A macro that returns without quitting will be reported as a failure after 90 seconds.&#x0A;&#x0A;A Sub with a parameter no longer appears in Word's Alt+F8 list. That's expected; it's driven by DevStrider, not by hand."/>

          <TextBlock Text="2 · Create the profile" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Profiles tab — one profile per real person you bid as. Point it at that person's .docm, leave the macro name blank to use UpdateResumeAndSwitchOriginal, and press Insert default to get a resume prompt that emits every marker the macro expects. Switch the active profile from the title-bar dropdown; every bid and interview belongs to whichever profile was active when it was created.&#x0A;&#x0A;Before any of that: the database. The sign-in window has a Database connection panel — service URI, or host/port/database/user/password — with a Test connection button. Fill it in once and it is remembered. The tables are not created for you: run desktop/shared-db-schema.sql against that database by hand, once for the whole team.&#x0A;&#x0A;You sign in with your company portal account. There is no sign-up here and no username to pick — your portal address is who you are, on this machine and on everyone else's Peers tab."/>

          <TextBlock Text="3 · Sign in to the embedded browsers" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Open Resume Studio and sign in to ChatGPT in its persistent browser. Open Application Queue and sign in to each job provider when required. The two browser profiles stay separate and preserve their own login state."/>

          <TextBlock Text="4 · Application queue" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Paste job URLs into Application Queue and approve the automatic flow. DevStrider opens each page, extracts the JD, uses ChatGPT and Word to build the resume, fills supported fields, uploads the generated document, and submits through the selected site adapter. Site validation errors receive one targeted correction pass; only ambiguous or unresolved results pause for review. If extraction fails, paste the JD into the recovery box and continue. Resume Studio handles recruiter-provided JDs that do not have an application URL."/>

          <TextBlock Text="5 · Tracking" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Bids tab is the day's board — edit a row, apply a fast-feed line by hand, or schedule an interview off a bid (the JD and resume id carry forward). Interviews tab shows a date range and can schedule the next round off an existing one. Find bid searches your history. Overview and Stats aggregate you and your teammates, live."/>

          <TextBlock Text="6 · The team's data" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="There is nothing to sync. Every machine reads and writes the same database, so a teammate's bid appears the moment they save it and yours appears to them the moment you do.&#x0A;&#x0A;Everything is visible to everyone: job URLs, job descriptions, generated resume text, meeting links and your comments included. Treat these tables as the team's, not yours.&#x0A;&#x0A;Peers tab is the other direction — pick a teammate, then one of their profiles."/>

          <TextBlock Text="If something looks wrong" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="Activity records browser automation, sign-in, adapter, upload, and macro results with failure details.&#x0A;&#x0A;Blank document sections → the ChatGPT reply missed the profile prompt's [Section]: labels.&#x0A;Macro failure after ~90s → the macro did not call Application.Quit or its String parameter is missing.&#x0A;Nothing happens → open the affected workspace, confirm that it is signed in, dismiss dialogs, and use its recovery controls.&#x0A;&#x0A;The app keeps running in the tray after you close the window — right-click the tray icon and choose Quit to actually stop it."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Environment variables" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding EnvVarTip}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <DataGrid ItemsSource="{Binding EnvVars}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Variable"     Binding="{Binding Name}"         Width="220"/>
              <DataGridTextColumn Header="Seeds"        Binding="{Binding SeedsField}"   Width="200"/>
              <DataGridTextColumn Header="Status"       Binding="{Binding Status}"       Width="80"/>
              <DataGridTextColumn Header="Current value" Binding="{Binding DisplayValue}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap">
            <Run Text="Hover any row above for what it seeds. Each variable feeds its field "/>
            <Run Text="only when the field is empty or at its default — once you've set the "/>
            <Run Text="value in Settings, the env var is ignored on subsequent launches."/>
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Setting env vars on Windows" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="Persistent (survives reboot, user scope) — run in PowerShell or cmd:"/>
          <Border Background="{StaticResource SurfaceAlt}" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                       Text="setx DEVSTRIDER_SHARED_DB_URI &quot;postgresql://user:pass@host:5432/devstrider?sslmode=require&quot;&#x0A;setx DEVSTRIDER_LISTENER_PORT &quot;8765&quot;&#x0A;setx DEVSTRIDER_WORD_DOC_PATH &quot;C:\Users\you\Documents\resume.docm&quot;"/>
          </Border>
          <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="Then close and re-open DevStrider. After it picks them up you can clear them again — the values are stored in plaintext in settings.json under %LOCALAPPDATA%\DevStrider."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
