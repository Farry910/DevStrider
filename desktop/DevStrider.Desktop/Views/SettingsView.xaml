<UserControl x:Class="DevStrider.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="MongoDB connection" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Connection URI"/>
          <TextBox Text="{Binding Model.MongoUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                   Tag="mongodb://127.0.0.1:27017"/>
          <TextBlock Text="Database name"/>
          <TextBox Text="{Binding Model.DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                   Tag="devstrider"/>
          <TextBlock Foreground="{StaticResource Muted}"
                     Text="Restart DevStrider after changing these — the connection is created at startup."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="How teammates find you in the shared database. Your username owns the profiles you bid as — peers pick you first, then one of your profiles. There is no password: this identifies you, it doesn't authenticate you."/>

          <TextBlock Text="Username"/>
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                   Tag="e.g. joshua"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Defaults to your Windows account name, lowercased. Keep it lowercase with no spaces — it's the key your bids and interviews are filed under, so changing it later orphans everything already pushed."/>

          <TextBlock Text="Email"/>
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                   Tag="you@example.com"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Contact address shown to teammates alongside your name. Visible to everyone on the shared database."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Peer database (shared PostgreSQL)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="The database that holds everyone's bid and interview summaries. Tables are created automatically on the first sync. Shared: company, role, status, stacks, dates and the job description. Not shared: job URLs, generated resume text, meeting links and your comments."/>

          <!-- Two ways to describe the same server: providers hand out a URI, self-hosted is
               easier in parts. Whichever is selected is the one that's used; the other keeps
               what you typed. -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="Service URI" GroupName="SharedDbMode"
                         IsChecked="{Binding IsUriMode, Mode=TwoWay}" Margin="0,0,16,0"/>
            <RadioButton Content="Host / port / database" GroupName="SharedDbMode"
                         IsChecked="{Binding IsPartsMode, Mode=TwoWay}"/>
          </StackPanel>

          <!-- Mode 1: service URI -->
          <StackPanel Visibility="{Binding IsUriMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Service URI"/>
            <TextBox Text="{Binding Model.SharedDbUri, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     Margin="0,2,0,8"
                     Tag="postgresql://user:password@host:5432/devstrider?sslmode=require"/>
          </StackPanel>

          <!-- Mode 2: discrete parts -->
          <StackPanel Visibility="{Binding IsPartsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Host"/>
                <TextBox Text="{Binding Model.SharedDbHost, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Margin="0,2,0,0" Tag="db.example.com"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Port"/>
                <TextBox Text="{Binding Model.SharedDbPort, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Margin="0,2,0,0" Tag="5432"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Database"/>
            <TextBox Text="{Binding Model.SharedDbName, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" Margin="0,2,0,8" Tag="devstrider"/>

            <TextBlock Text="User"/>
            <TextBox Text="{Binding Model.SharedDbUser, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" Margin="0,2,0,8"/>

            <TextBlock Text="Password"/>
            <!-- PasswordBox has no bindable Password property by design, so the value reaches
                 the view-model through a PasswordChanged handler in the code-behind. -->
            <PasswordBox x:Name="SharedDbPasswordBox"
                         PasswordChanged="SharedDbPasswordBox_PasswordChanged"
                         FontFamily="Consolas"
                         Margin="0,2,0,8"/>
          </StackPanel>

          <CheckBox Content="Require SSL/TLS"
                    IsChecked="{Binding Model.SharedDbRequireSsl, Mode=TwoWay}"
                    Margin="0,0,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Leave on for any hosted provider — Supabase, Neon, Railway and Aiven all require it. Turn it off only for a local server that isn't listening on TLS. An explicit sslmode in the URI overrides this."/>

          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="{Binding SharedDbHint}"/>

          <TextBlock Text="Automatic sync interval (minutes)"/>
          <TextBox Text="{Binding Model.SyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,4"
                   Tag="60"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Text="Peer data is pushed and pulled on this cadence in the background. 0 disables it and leaves only the Sync now button; anything under 5 is treated as 5. The first run happens a couple of minutes after launch."/>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Save settings" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding TestSharedConnectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Test connection" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding ClearSharedPasswordAsyncCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Clear password" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Cloud storage (Cloudflare R2)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Bucket that holds resume files shared with peers. Like the peer database, these are stored in the local database and loaded at startup. An API token with object-write permission can also delete objects — everyone holding it can empty the bucket."/>

          <TextBlock Text="Account ID"/>
          <TextBox Text="{Binding Model.R2AccountId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="hex prefix of the r2.cloudflarestorage.com endpoint"/>

          <TextBlock Text="Bucket"/>
          <TextBox Text="{Binding Model.R2Bucket, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="devstrider"/>

          <TextBlock Text="Access key ID"/>
          <TextBox Text="{Binding Model.R2AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"/>

          <TextBlock Text="Secret access key"/>
          <PasswordBox x:Name="R2SecretBox"
                       PasswordChanged="R2SecretBox_PasswordChanged"
                       FontFamily="Consolas"
                       Margin="0,2,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="{Binding R2SecretHint}"/>

          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="{Binding R2EndpointDisplay}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Bid-Assistant integration (local HTTP listener)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="DevStrider listens on http://127.0.0.1:&lt;port&gt; for POSTs from the Bid-Assistant Chrome extension. Loopback-only — no authentication. Point the extension at this URL and bids you record from ChatGPT land directly in the local Mongo."/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Muted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LocalApi.IsRunning}" Value="True">
                      <Setter Property="Background" Value="{StaticResource OK}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Text="{Binding LocalApi.Status}" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="Port"/>
          <TextBox Text="{Binding Model.ListenerPort, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,8" MaxLength="5"
                   Tag="8765"/>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding RestartListenerCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Restart listener" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Extension contract: POST /record-bid with JSON body { url, jobDescription, gptResumeContent, fastFeedInput?, sharedJobDescription?, comment?, origin? }. Fast-feed format: 'UID, Company, Role, Stack1, Stack2, …' — same as the resume-filename convention."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Word macro hotkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Shared by every profile. The .docm path itself lives per-profile under Profiles (each identity can point at its own macro file)."/>

          <TextBlock Text="Hotkey that triggers the macro"/>
          <TextBox Text="{Binding Model.WordHotkey, UpdateSourceTrigger=PropertyChanged}"
                   Tag="F9   (or Ctrl+Shift+R, etc.)"
                   Margin="0,2,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,0" TextWrapping="Wrap"
                     Text="Default F9 runs Word's 'update fields' macro. Ctrl+S, Ctrl+Shift+R, etc. are accepted."/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
