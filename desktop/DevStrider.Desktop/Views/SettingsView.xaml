<UserControl x:Class="DevStrider.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Who you are signed in as, and how teammates see you on the Peers tab. Your account owns the profiles you bid as — peers pick you first, then one of your profiles."/>

          <TextBlock Text="Signed in as"/>
          <TextBlock Text="{Binding SignedInAs}" FontWeight="SemiBold" Margin="0,2,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="This is your company portal account, and it is not editable here. Accounts, passwords and addresses are managed in the portal; DevStrider reads them and never writes them. Change your address there and it follows you here on the next sign-in."/>

          <TextBlock Text="The address on your resume is per profile — Profiles tab, not here."
                     Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Resume automation" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="A resume chat is one fresh ChatGPT conversation. DevStrider starts another conversation after this many successful resume generations to protect formatting quality."/>
          <TextBlock Text="Resumes per ChatGPT conversation"/>
          <TextBox Text="{Binding Model.ResumeGenerationsPerChat, UpdateSourceTrigger=PropertyChanged}"
                   Width="80" HorizontalAlignment="Left" Margin="0,2,0,8" Tag="10"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="The output root and generated file name live on each profile now, beside its Word document and macro — they describe that document, not this machine."/>
        </StackPanel>
      </Border>

      <!--
        Proxy. This exists because ChatGPT is unreachable from some of the places people run
        DevStrider from, and the entire app is built around driving ChatGPT in a real browser —
        so without this it does not work there at all, rather than working slowly.
      -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Proxy" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Routes browser traffic through a proxy, for running DevStrider where ChatGPT is not reachable. Job sites keep the direct connection unless you widen the scope — they are usually reachable already, and an extra hop is paid on the part of a run that does the most page work."/>

          <CheckBox IsChecked="{Binding Model.ProxyEnabled}" Margin="0,0,0,10"
                    Content="Route browser traffic through a proxy"/>

          <TextBlock Text="Proxy address"/>
          <TextBox Text="{Binding Model.ProxyAddress, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{StaticResource UiFontMono}" Margin="0,2,0,4"
                   Tag="host:port, or scheme://host:port"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="http, https, socks4 or socks5 — a browser accepts no other proxy scheme. A bare host:port is treated as http."/>

          <TextBlock Text="Applies to"/>
          <ComboBox ItemsSource="{Binding ProxyScopeOptions}"
                    SelectedItem="{Binding Model.ProxyScope}"
                    Width="180" HorizontalAlignment="Left" Margin="0,2,0,10"/>

          <TextBlock Text="Username (only if the proxy asks for one)"/>
          <TextBox Text="{Binding Model.ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,8" Width="260" HorizontalAlignment="Left"/>

          <TextBlock Text="Password"/>
          <TextBox Text="{Binding Model.ProxyPassword, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,4" Width="260" HorizontalAlignment="Left"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Stored in cleartext in this machine's settings file, like the other credentials here, and never written to the trace or the activity log. SOCKS proxies cannot be given a password by a browser at all — use an http proxy if yours needs one."/>

          <TextBlock Text="Reach these directly (bypass)"/>
          <TextBox Text="{Binding Model.ProxyBypassList, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{StaticResource UiFontMono}" Margin="0,2,0,4"
                   Tag="&lt;local&gt;, *.corp.example, 10.0.0.0/8"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Comma-separated. The company portal is always bypassed whether or not it is listed: signing in is traffic you can already reach, and there is no reason to send a session token through someone else's server."/>

          <TextBlock Text="{Binding ProxyHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Save settings" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding TestProxyCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Test proxy against ChatGPT" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Company portal" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="Where DevStrider signs in and where every bid and interview is stored. There is no local copy and no database credential on this machine — the portal holds that, and this app holds a session token instead. Everything you save is visible to everyone on the team, job URLs, job descriptions, resume text and comments included."/>

          <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="{Binding SessionHint}"/>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Save settings" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding TestPortalCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Test connection" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding SignOutCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Sign out on this machine" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!--
        ChatGPT accounts. Automatic runs and manual bids each drive their own ChatGPT browser so
        they can run at once, and a browser's identity is its user-data folder — so assigning a lane
        to an account is the same thing as choosing which folder its browser opens.
      -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ChatGPT accounts" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Automatic runs and manual bids each get their own ChatGPT browser, so a manual bid's resume can be written while the queue is mid-generation. Give them separate accounts and the two never contend at all — separate conversations and separate rate limits. Leave them on one account and they still run at once; the app just keeps them out of each other's chat."/>

          <TextBlock Text="Accounts" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
          <ListBox ItemsSource="{Binding ChatGptAccounts}" SelectedItem="{Binding SelectedChatGptAccount}"
                   MaxHeight="110" Margin="0,0,0,6" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12"/>
                  <TextBlock Text="{Binding UserDataFolder}" FontSize="10" Opacity="0.6"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Text="{Binding NewChatGptAccountName, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Margin="0,0,8,0" Tag="new account name"/>
            <Button Command="{Binding AddChatGptAccountCommand}" Content="Add" Margin="0,0,8,0"/>
            <Button Command="{Binding RenameChatGptAccountCommand}" Content="Rename to typed name"
                    Margin="0,0,8,0"
                    ToolTip="Renames the selected account. Its browser profile does not move — moving it would sign the account out."/>
            <Button Command="{Binding RemoveChatGptAccountCommand}" Content="Remove"
                    ToolTip="Forgets the account. Its browser profile is left on disk, so the signed-in session survives if you add it back."/>
          </StackPanel>

          <TextBlock Text="Who signs in as what" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Automatic runs" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                      ItemsSource="{Binding ChatGptAccounts}" DisplayMemberPath="Name"
                      SelectedItem="{Binding AutoLaneAccount}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Manual bids" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding ChatGptAccounts}" DisplayMemberPath="Name"
                      SelectedItem="{Binding ManualLaneAccount}"/>
          </Grid>

          <TextBlock Text="{Binding ChatGptSharingNote}" Style="{StaticResource MutedText}"
                     TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="A new account starts signed out. Open its workspace — Resume Studio, or Resume Studio · manual — and sign in once; the session persists because the browser profile does. Changing an assignment takes effect when that workspace's browser next starts."/>
          <TextBlock Text="{Binding ChatGptStatus}" TextWrapping="Wrap"
                     Visibility="{Binding ChatGptStatus, Converter={StaticResource NonEmptyToVisible}}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Cloud storage (Cloudflare R2)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Bucket that holds resume files shared with peers. Like the peer database, these are stored in the local database and loaded at startup. An API token with object-write permission can also delete objects — everyone holding it can empty the bucket."/>

          <TextBlock Text="Account ID"/>
          <TextBox Text="{Binding Model.R2AccountId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="hex prefix of the r2.cloudflarestorage.com endpoint"/>

          <TextBlock Text="Bucket"/>
          <TextBox Text="{Binding Model.R2Bucket, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="devstrider"/>

          <TextBlock Text="Access key ID"/>
          <TextBox Text="{Binding Model.R2AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"/>

          <TextBlock Text="Secret access key"/>
          <PasswordBox x:Name="R2SecretBox"
                       PasswordChanged="R2SecretBox_PasswordChanged"
                       FontFamily="Consolas"
                       Margin="0,2,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="{Binding R2SecretHint}"/>

          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="{Binding R2EndpointDisplay}"/>

          <!-- Prove the token here rather than discovering it is wrong halfway through an
               upload the user believed had worked. -->
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding TestR2Command}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Test cloud storage" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding R2TestResult}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Optional local HTTP integration" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="DevStrider can accept compatible local-tool POSTs on http://127.0.0.1:&lt;port&gt;. It binds only to loopback and is not used by the embedded Application Queue workflow."/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Muted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LocalApi.IsRunning}" Value="True">
                      <Setter Property="Background" Value="{StaticResource OK}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Text="{Binding LocalApi.Status}" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="Port"/>
          <TextBox Text="{Binding Model.ListenerPort, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,8" MaxLength="5"
                   Tag="8765"/>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding RestartListenerCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Restart listener" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Local contract: POST /record-bid with JSON body { url, jobDescription, gptResumeContent, fastFeedInput?, comment?, origin? }. Fast-feed format: 'UID, Company, Role, Stack1, Stack2, …'."/>

          <!--
            Powerful and deliberately visible. /dev/eval runs script inside a signed-in ChatGPT
            browser, so it is a switch rather than something always on - but while the automation is
            still being built, being able to look at the real page is the difference between a
            diagnosis and a guess.
          -->
          <CheckBox IsChecked="{Binding Model.DeveloperTools}" Margin="0,14,0,0"
                    Content="Developer tools (/dev endpoints)"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Opens /dev on the same loopback port: app state, the activity log, and script, DOM and screenshot access to the embedded browsers. GET http://127.0.0.1:8765/dev lists them. Turn this off for anyone who is not developing the app."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Word macro hotkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Shared by every profile. The .docm path itself lives per-profile under Profiles (each identity can point at its own macro file)."/>

          <TextBlock Text="Hotkey that triggers the macro"/>
          <TextBox Text="{Binding Model.WordHotkey, UpdateSourceTrigger=PropertyChanged}"
                   Tag="F9   (or Ctrl+Shift+R, etc.)"
                   Margin="0,2,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,0" TextWrapping="Wrap"
                     Text="Default F9 runs Word's 'update fields' macro. Ctrl+S, Ctrl+Shift+R, etc. are accepted."/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
