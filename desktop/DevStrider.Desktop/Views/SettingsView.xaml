<UserControl x:Class="DevStrider.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Legacy MongoDB (import only)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="This machine's old local database. It is read once, to carry an existing install's saved settings across, and never written to. Once that has happened the MongoDB service can be stopped and uninstalled — leave these fields alone on a machine that never had one."/>
          <TextBlock Text="Connection URI"/>
          <TextBox Text="{Binding Model.MongoUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                   Tag="mongodb://127.0.0.1:27017"/>
          <TextBlock Text="Database name"/>
          <TextBox Text="{Binding Model.DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4"
                   Tag="devstrider"/>
          <TextBlock Foreground="{StaticResource Muted}"
                     Text="Restart DevStrider after changing these — the connection is created at startup."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Identity" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Who you are signed in as, and how teammates see you on the Peers tab. Your account owns the profiles you bid as — peers pick you first, then one of your profiles."/>

          <TextBlock Text="Signed in as"/>
          <TextBlock Text="{Binding SignedInAs}" FontWeight="SemiBold" Margin="0,2,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="This is your hr-system account, and it is not editable here. Accounts, passwords and addresses are managed there; DevStrider reads them and never writes them. Change your address there and it follows you here on the next sign-in."/>

          <TextBlock Text="The address on your resume is per profile — Profiles tab, not here."
                     Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="hr-system" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="Every account and every bid or interview now lives behind hr-system's API, not a database this app connects to directly. Signing in exchanges your email and password for a week-long token, so you are not asked again on every launch — see Sign out below to drop it."/>

          <TextBlock Text="Server address"/>
          <TextBox Text="{Binding Model.HrApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="https://triospace.org/hr"/>

          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="{Binding HrTokenHint}"/>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Save settings" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding SignOutCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Sign out" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Cloud storage (Cloudflare R2)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Bucket that holds resume files shared with peers. Like the peer database, these are stored in the local database and loaded at startup. An API token with object-write permission can also delete objects — everyone holding it can empty the bucket."/>

          <TextBlock Text="Account ID"/>
          <TextBox Text="{Binding Model.R2AccountId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="hex prefix of the r2.cloudflarestorage.com endpoint"/>

          <TextBlock Text="Bucket"/>
          <TextBox Text="{Binding Model.R2Bucket, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"
                   Tag="devstrider"/>

          <TextBlock Text="Access key ID"/>
          <TextBox Text="{Binding Model.R2AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas"
                   Margin="0,2,0,8"/>

          <TextBlock Text="Secret access key"/>
          <PasswordBox x:Name="R2SecretBox"
                       PasswordChanged="R2SecretBox_PasswordChanged"
                       FontFamily="Consolas"
                       Margin="0,2,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="{Binding R2SecretHint}"/>

          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="{Binding R2EndpointDisplay}"/>

          <!-- Prove the token here rather than discovering it is wrong halfway through an
               upload the user believed had worked. -->
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding TestR2Command}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Test cloud storage" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding R2TestResult}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Bid-Assistant integration (local HTTP listener)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="DevStrider listens on http://127.0.0.1:&lt;port&gt; for POSTs from the Bid-Assistant Chrome extension. Loopback-only — no authentication. Point the extension at this URL and bids you record from ChatGPT land directly in the local Mongo."/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Muted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LocalApi.IsRunning}" Value="True">
                      <Setter Property="Background" Value="{StaticResource OK}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Text="{Binding LocalApi.Status}" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="Port"/>
          <TextBox Text="{Binding Model.ListenerPort, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,2,0,8" MaxLength="5"
                   Tag="8765"/>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding RestartListenerCommand}" Style="{StaticResource GhostButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Restart listener" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Extension contract: POST /record-bid with JSON body { url, jobDescription, gptResumeContent, fastFeedInput?, comment?, origin? }. Fast-feed format: 'UID, Company, Role, Stack1, Stack2, …' — same as the resume-filename convention."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Word macro hotkey" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Shared by every profile. The .docm path itself lives per-profile under Profiles (each identity can point at its own macro file)."/>

          <TextBlock Text="Hotkey that triggers the macro"/>
          <TextBox Text="{Binding Model.WordHotkey, UpdateSourceTrigger=PropertyChanged}"
                   Tag="F9   (or Ctrl+Shift+R, etc.)"
                   Margin="0,2,0,4"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,0" TextWrapping="Wrap"
                     Text="Default F9 runs Word's 'update fields' macro. Ctrl+S, Ctrl+Shift+R, etc. are accepted."/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
