<UserControl x:Class="DevStrider.Desktop.Views.CallerCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnViewSizeChanged">
  <DockPanel>

    <!-- Week controls. The caller line says whose diary this is and how much of it isn't yours,
         which is the number that makes the screen worth looking at. -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Command="{Binding PreviousWeekCommand}" Style="{StaticResource IconButton}"
                ToolTip="Previous week" Content="&#xE76B;"/>
        <Button Command="{Binding TodayCommand}" Style="{StaticResource GhostButton}"
                Margin="4,0" Padding="10,3">
          <TextBlock Text="Today" FontSize="11"/>
        </Button>
        <Button Command="{Binding NextWeekCommand}" Style="{StaticResource IconButton}"
                ToolTip="Next week" Content="&#xE76C;"/>
        <TextBlock Text="{Binding RangeLabel}" FontWeight="SemiBold" FontSize="14"
                   VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>

      <TextBlock Grid.Column="1" Text="{Binding CallerLabel}" Style="{StaticResource MutedText}"
                 VerticalAlignment="Center" Margin="18,0" TextWrapping="Wrap"/>

      <Button Grid.Column="2" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}"
              ToolTip="Reload the caller's week" Content="&#xE72C;"/>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
               Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
               Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyToVisible}}"/>

    <!-- Day headers. Kept outside the ScrollViewer so they stay put, and padded on the right by
         the scrollbar's width so its columns line up with the grid underneath. -->
    <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Height="46"/>

    <!-- Interviews the caller has in this week with no usable time on them. They are real
         commitments; a conflict screen that silently dropped them would be worse than no screen. -->
    <Border x:Name="UntimedBand" DockPanel.Dock="Top"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,1"
            Padding="8,5" Visibility="Collapsed">
      <StackPanel x:Name="UntimedHost" Orientation="Horizontal"/>
    </Border>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
      <Canvas x:Name="Surface" Background="{StaticResource Surface}"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
