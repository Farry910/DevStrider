<UserControl x:Class="DevStrider.Desktop.Views.ResumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Resume auto-gen" Style="{StaticResource H1}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Counts}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted}"/>
      <Button Grid.Column="2" Command="{Binding ReloadCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh" Content="&#xE72C;"/>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <!-- Paste + controls -->
    <Border DockPanel.Dock="Top" Style="{StaticResource FlatCard}">
      <StackPanel>
        <TextBlock Text="Paste job links (one per line) for the active profile, then Start. Keep a logged-in ChatGPT tab open — it runs in the background while you work elsewhere." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Height="120"
                 FontFamily="Consolas"
                 Tag="https://job-boards.greenhouse.io/...&#x0A;https://www.linkedin.com/jobs/view/..."/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Command="{Binding StartCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Start" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Pause" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="4,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,6,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Muted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource OK}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Paused"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Text" Value="Running"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Button Command="{Binding RetryFailedCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" ToolTip="Re-queue all failed jobs">
            <TextBlock Text="Retry failed" VerticalAlignment="Center"/>
          </Button>
          <Button Command="{Binding ClearFinishedCommand}" Style="{StaticResource GhostButton}" ToolTip="Remove Done + Failed rows">
            <TextBlock Text="Clear finished" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Queue -->
    <DataGrid ItemsSource="{Binding Jobs}" IsReadOnly="True" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Status"   Binding="{Binding Status}" Width="130" SortMemberPath="Status"/>
        <DataGridTextColumn Header="URL"      Binding="{Binding Url}" Width="2*" SortMemberPath="Url"/>
        <DataGridTextColumn Header="Output"   Binding="{Binding Filename1}" Width="*"/>
        <DataGridTextColumn Header="Error"    Binding="{Binding Error}" Width="*"/>
        <DataGridTextColumn Header="Updated"  Binding="{Binding UpdatedAt, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
        <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding ., FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                      Style="{StaticResource DangerIconButton}"
                      ToolTip="Remove from queue"
                      Content="&#xE74D;"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
