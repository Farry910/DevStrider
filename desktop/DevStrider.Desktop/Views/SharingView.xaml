<UserControl x:Class="DevStrider.Desktop.Views.SharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Peer sync" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>

      <!-- Sync card -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Sync with the shared database" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Two ways to sync, both doing the same push + pull: automatically on a schedule, and on demand with the button below. Either one uploads your bids and interviews changed since the last run and downloads everyone else's.&#x0A;&#x0A;Shared: company, role, status, stacks, dates and the job description. Not shared: job URLs, generated resume text, meeting links and your comments."/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Last sync" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastSyncDisplay}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Automatic" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AutoSyncDisplay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SyncCommand}"
                    IsEnabled="{Binding IsConfigured}"
                    Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Sync now" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Refresh status" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <!-- "Already synced" is one timestamp on this machine, not a flag per row. If the
                 shared tables are rebuilt, this is the only way to make them whole again. -->
            <Button Command="{Binding ResyncAllCommand}"
                    IsEnabled="{Binding IsConfigured}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Clear the sync marker and push every bid and interview again. Safe to repeat — every write is an upsert.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE117;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Re-send everything" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Shared-database status. Read-only: the app issues no DDL, so nothing here can
           create, alter or drop anything. The schema is applied by hand from
           desktop/shared-db-schema.sql. -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Shared database status" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="DevStrider's three tables and how many rows each holds. A count of -1 means the table is missing — apply desktop/shared-db-schema.sql to the database. DevStrider never creates or alters tables itself, so it is safe to point at a database shared with other applications."/>

          <DataGrid ItemsSource="{Binding RemoteTables}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    Margin="0,0,0,8"
                    MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Rows"  Binding="{Binding RowCount}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>

          <Button Command="{Binding LoadRemoteTablesCommand}" Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Refresh" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
