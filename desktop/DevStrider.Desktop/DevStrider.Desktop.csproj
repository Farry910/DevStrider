<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET 10 (LTS, supported to Nov 2028). .NET 8 leaves support on 10 Nov 2026, and the machine
      that builds this only ever had a preview 8 SDK, which is what made Npgsql fail with
      MissingMethodException on DbBatchCommand.CreateParameter().
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      We compose WPF + WinForms in the same process so we can use
      System.Windows.Forms.NotifyIcon for the system-tray icon. WPF doesn't have
      a built-in tray API; rather than pull a NuGet (Hardcodet.NotifyIcon.Wpf)
      we use the in-box WinForms one. The two stacks coexist fine â€” we don't
      run a WinForms message loop, the existing WPF dispatcher handles events.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!--
      ImplicitUsings auto-imports System / System.Collections.Generic / System.Linq /
      System.Threading.Tasks / System.IO etc. on every .cs file. Without it the source-
      generator can't see Task as a return type, so [RelayCommand] rejects every async
      method with MVVMTK0007.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DevStrider.ico</ApplicationIcon>
    <AssemblyName>DevStrider</AssemblyName>
    <!-- Bump this string on every release. The MainWindow title bar reads it at runtime
         so you can eyeball whether the build picked up the latest source. -->
    <!--
      Patch number counts bug fixes since the minor. 7.2.0 was the .NET 10 retarget; .1 the
      peer_users created_at NOT NULL violation, .2 the stale username_1 unique index, .3 the
      immutable _id on the identity mirror's ReplaceOne. 7.7.0 dropped the PowerShell hop from
      the resume macro and made the Word instance warm + prewarmed. 7.8.0 deleted the retired
      resume-storage feature — a minor, not a patch, since it removes types rather than fixing
      behaviour. 7.9.0 made the Profiles editor scroll with its action row pinned, so Save can no
      longer be clipped off the bottom at small window sizes. 8.0.0 finished the move to the
      shared PostgreSQL database: sign-in against the portal's app_user, every screen reading and
      writing ds_* directly, and the peer mirror plus its Sharing tab deleted — a major, since
      settings, storage and startup all changed shape. 8.1.0 dropped ds_education,
      ds_certifications, ds_experiences and ds_achievements: the CV belongs to each profile's
      .docm, which is the copy people actually edit, and the achievement counters had no reader.
      8.2.0 batches bid writes behind a disk-backed queue, adds the one-time import of a machine's
      old local MongoDB, replaces the bid board's job-URL box with a fast-feed one, and drops
      ds_profiles.highest_education — which 8.1.0 had added and nothing ever read. It also fixes
      sign-in, which could never have worked: the portal hashes with scrypt rather than bcrypt,
      and its app_user.id / email_verified are integers that the strict Npgsql readers threw on.
      8.3.0 drops the legacy-MongoDB data import in favour of Bids -> From folder, which records
      bids from the resume folders the macro already wrote to disk, each timed by its own folder's
      creation time — a record that does not depend on anyone's old database still being installed.
      9.0.0 drops the shared Postgres connection entirely: sign-in and every ds_* read/write now go
      through hr-system's /api/devstrider/* HTTP API and a week-long bearer token instead of a
      connection string held on this machine — a major, since the app no longer carries a database
      credential at all, and Settings' "Shared database" card became "hr-system" (server address,
      not host/port/user/password). Npgsql and BouncyCastle are gone with it. The resume macro also
      gained a second parameter so it can write the job description alongside the resume it saves —
      see desktop/macro.md; a template still on the one-argument signature is called the old way
      rather than failing, so an un-updated .docm keeps producing resumes.
      9.1.0 moves the job-description file out of the macro and into the app: once the bid is
      recorded, /generate-resume writes Job Description.txt into the resume's own folder, composed
      as the profile template's directory plus the [FolderName]: line (invalid path characters
      mapped to '-' the way the macro maps them). It used to be the macro's job via the second
      argument, which meant a template on the one-argument signature produced no file at all.
      The bid board's bulk-actions toolbar is gone too — the bar that slid in above the grid on
      selection with a status picker, Apply and Delete. Every one of those is already on the row
      itself, so it was a second copy of the same controls that shoved the table down whenever you
      clicked one. Its view-model half (SelectedCount, HasSelection, BulkStatus, AllBidStatuses,
      BulkApplyStatus, BulkDelete, ExtractSelectedRows) went with it.
      Two removals as well, both of things the 9.0 rewrite left without a job. The legacy local MongoDB is gone
      — LegacyStore, the MongoDB.Driver package, the one-time lift of its settings row into
      settings.json, and the DEVSTRIDER_MONGO_URI / DEVSTRIDER_DATABASE_NAME variables. MongoDB.Bson
      stays: ObjectId is still the identity type on every model and in ds_*.id. And the Word macro
      hotkey is gone — the setting, DEVSTRIDER_WORD_HOTKEY, its Settings card, the /refresh-word
      endpoint it existed for, and the window-automation half of KeyboardHelper. The macro is
      invoked over COM against an invisible Word instance with its arguments passed directly, so
      there is nothing left to synthesize a keystroke at.
      9.2.0 adds the caller. ds_profiles.caller_id is app_user.id of whoever takes that profile's
      interviews — a different job from bidding, and routinely a different person, so it is its own
      column rather than a reading of user_id. One caller covers several profiles and those profiles
      need not share an account, which is why the new Interviews → Caller calendar tab reads through
      IPeerDirectory rather than this account's own rows: it draws the caller's whole week, with the
      active profile's interviews editable (drag to move, drag the bottom edge to resize, click to
      edit) and every other profile of the same caller drawn read-only to be scheduled around.
      Overlaps render as parallel columns and any write that lands on one names what it collides
      with before it goes through. A caller has one diary, so a double-booking is a mistake
      whichever profiles it spans — catching that before it happens is the whole point.
    -->
    <Version>9.2.0</Version>
    <RootNamespace>DevStrider.Desktop</RootNamespace>
  </PropertyGroup>

  <!-- Bundle the .ico so Window.Icon can load it at runtime (and Explorer can pick it
       up from the .exe via ApplicationIcon above). -->
  <ItemGroup>
    <Resource Include="Assets\DevStrider.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms=true auto-adds System.Windows.Forms to the implicit usings, which
    collides with System.Windows.* (Application / UserControl / MouseEventArgs / â€¦) in
    every WPF code-behind. Opt this single namespace out; TrayService.cs imports
    it explicitly with the aliases it needs.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- BSON only, for ObjectId â€” the identity type on every model and the 24-char hex string
         ds_profiles.id / ds_bids.id / ds_interviews.id hold. There is no MongoDB anywhere in the
         app any more: the driver went with the legacy local database in 9.1.0. -->
    <PackageReference Include="MongoDB.Bson" Version="2.28.0" />

    <!-- Cloudflare R2 speaks the S3 API, so the AWS SDK drives it directly: point it at
         https://<account>.r2.cloudflarestorage.com with region "auto" and path-style
         addressing. Hand-rolling SigV4 would be a lot of security-critical code for no gain. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.416.4" />

    <!-- DI container only â€” Hosting/Config/Logging aren't used in the WPF process. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />

    <!-- Charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />

    <!-- MVVM helpers -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
