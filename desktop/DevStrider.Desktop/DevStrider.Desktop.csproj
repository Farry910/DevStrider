<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET 10 (LTS, supported to Nov 2028). .NET 8 leaves support on 10 Nov 2026, and the machine
      that builds this only ever had a preview 8 SDK, which is what made Npgsql fail with
      MissingMethodException on DbBatchCommand.CreateParameter().
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      We compose WPF + WinForms in the same process so we can use
      System.Windows.Forms.NotifyIcon for the system-tray icon. WPF doesn't have
      a built-in tray API; rather than pull a NuGet (Hardcodet.NotifyIcon.Wpf)
      we use the in-box WinForms one. The two stacks coexist fine â€” we don't
      run a WinForms message loop, the existing WPF dispatcher handles events.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Was two <dpiAware*> elements in app.manifest, which WFO0003 rejects: the manifest is
         applied before the runtime can set the mode, so the two declarations conflict. Same
         behaviour, declared in the one place that wins. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <!--
      ImplicitUsings auto-imports System / System.Collections.Generic / System.Linq /
      System.Threading.Tasks / System.IO etc. on every .cs file. Without it the source-
      generator can't see Task as a return type, so [RelayCommand] rejects every async
      method with MVVMTK0007.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DevStrider.ico</ApplicationIcon>
    <AssemblyName>DevStrider</AssemblyName>
    <!-- Bump this string on every release. The MainWindow title bar reads it at runtime
         so you can eyeball whether the build picked up the latest source. -->
    <!--
      Patch number counts bug fixes since the minor. 7.2.0 was the .NET 10 retarget; .1 the
      peer_users created_at NOT NULL violation, .2 the stale username_1 unique index, .3 the
      immutable _id on the identity mirror's ReplaceOne. 7.7.0 dropped the PowerShell hop from
      the resume macro and made the Word instance warm + prewarmed. 7.8.0 deleted the retired
      resume-storage feature — a minor, not a patch, since it removes types rather than fixing
      behaviour. 7.9.0 made the Profiles editor scroll with its action row pinned, so Save can no
      longer be clipped off the bottom at small window sizes. 8.0.0 finished the move to the
      shared PostgreSQL database: sign-in against the portal's app_user, every screen reading and
      writing ds_* directly, and the peer mirror plus its Sharing tab deleted — a major, since
      settings, storage and startup all changed shape. 8.1.0 dropped ds_education,
      ds_certifications, ds_experiences and ds_achievements: the CV belongs to each profile's
      .docm, which is the copy people actually edit, and the achievement counters had no reader.
      8.2.0 batches bid writes behind a disk-backed queue, adds the one-time import of a machine's
      old local MongoDB, replaces the bid board's job-URL box with a fast-feed one, and drops
      ds_profiles.highest_education — which 8.1.0 had added and nothing ever read. It also fixes
      sign-in, which could never have worked: the portal hashes with scrypt rather than bcrypt,
      and its app_user.id / email_verified are integers that the strict Npgsql readers threw on.
      8.3.0 drops the legacy-MongoDB data import in favour of Bids -> From folder, which records
      bids from the resume folders the macro already wrote to disk, each timed by its own folder's
      creation time — a record that does not depend on anyone's old database still being installed.
    -->
    <!-- 9.0.0 replaces the separate manual resume/application handoffs with persistent embedded
         ChatGPT + job-site workspaces, a durable automatic queue, reviewed form fill/upload,
         conversation rotation, JD fallback, and Gmail/Calendar-assisted Job Operations.
         9.1.0 deletes the Bid Assistant Chrome extension, now that the embedded workspaces do
         its job, and makes a failed queue link recoverable: failures no longer end the batch,
         they collect with their error and attempt count for requeue, copy, or removal. A minor
         rather than a patch because it removes a component and adds queue state, and rather
         than a major because settings, storage and startup keep their shape. It also fixes the
         CAPTCHA gate that stopped every Greenhouse and Ashby application: both load score-based
         reCAPTCHA whose hidden badge and invisible anchor frame are not a challenge.
         9.1.1 makes Resume Studio show ChatGPT again. A new CoreWebView2 reports about:blank
         rather than an empty source, so the emptiness check guarding the first navigation was
         never true and the pane stayed blank for good. The retry the same rework intended on a
         failed start was also unreachable, because the workspace is built once and hidden, so
         Loaded fires only at startup; it now retries when the tab is next shown.
         9.1.2 stops the hidden workspace from going blind. A collapsed element is arranged at zero
         size and the WebView2 control forwards that straight to the browser as its viewport, so
         every element on the page measured as an empty box: the filler skipped every field and
         still asked for a review, and the ChatGPT driver never found its send button unless that
         tab was on screen. The workspaces bind to Hidden instead, which keeps the arranged size,
         and each handoff now brings its own workspace forward. Submitted links also leave the
         queue, since the bid row and the Activity entry are the durable record by then.
         9.1.3 stops ChatGPT's answer being filed as a Word fault. Word cannot fail fast on a reply
         that is not a resume — the macro never finds its labels, never quits, and reports "Macro
         timed out after 90s" — so a refusal, a rate-limit notice or a half-streamed message looked
         like a broken macro. The reply is now checked for the [Section]: labels the macro fills in
         before Word is launched, on the clipboard path as well as the automatic one, and the wait
         holds out for that shape instead of settling on the first text that stops changing.
         9.1.4 clears Word's Resiliency keys before launching it. Killing a wedged Word leaves the
         template filed as having "caused a serious error", and the next open stops on a modal that
         DisplayAlerts cannot suppress because it precedes the load — hanging the queue on a dialog
         on a hidden window. Dropdowns also fill now: a native select was assigned with a plain
         e.value, which React's value tracker treats as no change and reverts on the next render,
         and option matching accepted any substring, so "No" could answer "Norway". The review note
         now lists what is still empty, dropdowns included.
         9.1.5 stops the filler putting answers in the wrong boxes. textFor concatenated every
         label it could reach, including the first one inside an ancestor div — a neighbour's on
         any two-column form — so on Greenhouse the Country dropdown resolved as "Phone" and took
         the phone number, and "how many years of experience" resolved as "LinkedIn Profile" and
         took the URL. It now takes one authoritative label: aria-labelledby, then the description
         attribute, then label[for], then the element's own. react-select's search input is also
         excluded from the text pass, where typing into it looked like a fill and selected nothing,
         and a dropdown counts as answered only when it renders a chosen value.
         9.1.6 finds the generated resume. The macro names the file for the person the profile is
         for — Fernando.pdf — while this looked for {ResumeOutputFileBase}.pdf, defaulting to
         Resume.pdf, so every application reported no generated resume and asked for a manual
         upload. The folder is searched by extension now, preferring the PDF, with the newest
         folder under the root as a fallback when the macro's folder name does not match verbatim;
         only the parent folder has to be configured. The blanket refusal list also shrinks to what
         this app is never given — government ID, bank details — because the user supplies
         demographic, salary, work-authorisation and attestation answers themselves.
         9.2.0 adds the answer bank: ds_form_answers, one row per question per profile, keyed on
         the normalised question rather than the site, because every board words the same question
         differently. ChatGPT now answers from a reference block — profile, approved answers and
         the generated resume — and what it returns is stored unapproved; questions nothing could
         answer are stored empty. Job Operations gains an Answers tab listing site, field, question
         and answer, with per-row and bulk approval and a coverage line. A minor: it adds a table
         and a tab, and retires AppSettings.JobFormAnswers, whose contents migrate on first read.
         9.3.0 removes MongoDB. The driver had outlived the 8.3.0 import: all that still used it was
         SettingsService lifting an old settings row on first launch, which meant a fresh install
         spent five seconds reaching for a database nobody has any more. LegacyStore, that import,
         MongoUri/DatabaseName and their env vars and Settings panel are gone. ObjectId stayed
         behind as the identity type for every ds_*.id, so it is defined here now — same 12 bytes,
         same 24-character hex, same chronological ordering — and existing rows are untouched.
         9.3.1 makes Job Operations render. AssistedAutomationView was the one view in the project
         with no code-behind, so the XAML compiler emitted its InitializeComponent and nothing ever
         called it: the control instantiated with a null Content and the tab had been an empty white
         panel since it was added.
         9.4.0 replaces the answer bank with personal reference data. ds_form_answers, its service,
         repository and the Job Operations Answers tab are gone: storing a question-and-answer per
         field was the wrong unit, because every board words the same question differently. What
         ChatGPT needs is the person, so ds_person_facts holds their education, career history and
         any custom field, and the generated resume plus that reference block is what it answers
         each application from. ds_profiles is untouched and stays the single source of truth for
         name, location, phone, email and LinkedIn — the company portal reads that row too. The
         Profiles editor gains a Personal info section, and the resume prompt becomes an expander
         so it stops taking every spare pixel.
         9.4.1 makes the two page scripts agree on what a field is called. QuestionsScript still
         concatenated every label it could reach, so an Ashby field became the key "Name Name Type
         here..." while the filler, fixed in 9.1.5, looked itself up as "name" — every answer
         ChatGPT returned was discarded and Ashby filled 0 of 11. It now shares the fill prelude, so
         one rule names a field for both. Matching also works in both directions: a field labelled
         just "Name" could never match the key "full name", because only key-inside-label was tried.
         Best match wins rather than first, so "first name" is still not answered by "name".
         9.4.2 lets a person actually be entered. ds_profiles has held location, phone,
         personal_email, linkedin_url and headline since 8.0.0 and the form filler reads all five,
         but nothing in the app ever offered a box to type them into — so they were empty, and no
         amount of reference data could fill an Email or LinkedIn field. They are now in Profiles
         under Personal info, saving to the profile row the company portal shares. An empty answer
         from ChatGPT no longer overwrites one either: the lookup is case-insensitive, so a blank
         "Email" landed on the profile's own email and removed it from the fill. Radio and checkbox
         options are also asked as their group's question rather than one question per option.
         9.5.0 adds Job Operations -> Quick answers: the questions an application could not answer,
         raised the moment the fill finishes so they are in front of the user while the form is
         still open next door. An answer given there is written straight into the profile's personal
         info as a custom fact, which is what makes the same question fill itself afterwards — there
         is no separate answer store to keep in step. "How did you hear about..." now defaults to
         LinkedIn, keyed on the shortest wording that still matches every board.
         9.5.1 fixes two things that made the reference data and the resume chat unreliable. The
         personal data cache was filled on construction — before sign-in, so with no profile and
         nothing to read — and afterwards only on a profile switch, so editing Personal info never
         reached ChatGPT; it is now read fresh before the prompt and before each fill. And the
         resume conversation is remembered per profile: continuing a chat used to submit wherever
         the pane was pointing, so one click in ChatGPT's sidebar sent the next job description to
         a conversation that had never seen the profile prompt.
         9.5.2 resolves a field's label without assuming the markup. 9.4.2 read a radio group's
         question from its fieldset legend, which Ashby has no fieldset for, so its options came
         back as three separate questions and its comboboxes as "Start typing...". The label is now
         taken from the field's own wrapper — the nearest ancestor holding this control and nothing
         else fillable, radio options of one group counting as one control. Walking up stops at the
         first ancestor containing a different field, so a neighbour's label still cannot be reached,
         which is what 9.1.5 had to delete the old ancestor scan for. Verified against the live
         Ashby form in WebView2 rather than a fixture, which is how the previous attempt passed its
         test and still failed: Ashby has no fieldset on any control.
         9.5.3 sends the candidate answers with each choice question. A radio group or select now
         arrives as {question, options[]} so ChatGPT picks one of the control's own strings instead
         of inventing wording it will then reject; checkbox groups add "multiple": true, and a
         react-select, whose list is not in the DOM until it is opened, is marked as a dropdown so
         the model answers with a short likely value. Answer keys stay the plain question text.
         9.5.4 stops the form answers being thrown away in silence. NormalizeAnswersJson ended in
         catch (JsonException) { return "{}"; }, so a reply that did not parse became no answers at
         all with nothing logged — the application filled from saved personal data only and looked
         merely unlucky. The wait now holds out for a reply that parses into a non-empty object,
         the same predicate the resume step has had since 9.1.3 and this one never got, and a reply
         that still will not parse is reported to Activity with what ChatGPT actually said.
         9.5.5 removes the two silent dead-ends between the answers and the form. If the reply came
         back for a run that was no longer active, CompleteAutomatedResumeAsync returned quietly; if
         the queue row had gone, AcceptResumeResultAsync did the same. Either way Word never ran,
         nothing switched back to the job browser, and no status, log or failure was produced — the
         application simply stopped in Resume Studio. Both now report and fail the work item so the
         queue can recover it. Returning to the resume conversation afterwards is also best-effort:
         it is housekeeping, and letting it throw abandoned answers already in hand.
         9.6.0 traces an automatic bid end to end. An application crosses the job-site browser,
         ChatGPT, Word and the form filler, each in a different view-model reached through events,
         so when one stalled there was no single place showing how far it got — every bug this week
         cost a round trip of asking which screen said what. BidTraceService stamps every step with
         one short run id and an elapsed clock, from opening the queue item through navigation, the
         gate check, extraction, the prompts and replies in full, Word, the fill, each dropdown and
         the upload, to how the run ended. Activity keeps 4000 entries and gains Copy last run and
         Copy all, which render the feed as a plain-text transcript. A minor: new service, new
         commands, no behaviour changed.
         9.6.1 accepts the answers ChatGPT actually sends. The shape check sliced from the first {
         to the last } and parsed once, so a reply with a worked example beside the real object, a
         brace in the prose around it, or a line break inside a long value failed — and because the
         wait was told to hold out for that shape, it then spun for its full three minutes repeating
         the same rejection. AnswerJson finds each balanced top-level object, tries the longest
         first, and repairs the raw newlines innerText introduces when a value wraps in the rendered
         code block. The wait now logs the text it rejected, once per distinct reply rather than
         once a second.
         9.6.2 fills the way a person does, and stops corrupting what it fills with. innerText wraps
         a long line in the rendered code block, so a raw newline arrived after the email address
         and inside a question key; repairing those to spaces left "….com " and "Why  did you
         pick…", and a trailing space in an email field is read by the form as no email at all —
         which is why fields the log called filled came back as required. Answer text is now
         trimmed and its space runs collapsed, while escaped newlines, being deliberate, survive.
         Short fields are also typed a character at a time with real key events instead of having
         their whole value assigned; long prose answers are still set in one go, where no validator
         counts keystrokes and several thousand events would cost seconds.
         9.6.3 removes that long-answer exception after the live Ashby form proved it unsafe: all
         required prose answers were rendered but came back empty during validation. Every normal
         input and textarea now follows the full per-character keyboard/input sequence, regardless
         of length, and deliberate newlines produce Enter/insertLineBreak events.
         9.6.4 separates text completion from dropdown selection. Text values have trailing line
         breaks removed at the DOM boundary and never receive a completion Enter. Before asking
         ChatGPT, every unanswered custom dropdown is opened and its rendered options are collected
         across the whole scroll range, including virtualized lists. Filling prefers an exact option
         click, uses Enter only as a dropdown fallback, and verifies a rendered chosen value rather
         than mistaking search text for a selection. Resume upload now precedes typing so an Ashby
         upload rerender cannot discard already-filled controlled fields.
         9.6.5 sources Ashby's static dropdown candidates from the read-only application-form schema,
         whose ValueSelect fields include their complete selectableValues list. DOM discovery remains
         the fallback for other providers and autocomplete controls: it recognizes newly mounted menu
         rows without requiring ARIA option roles and types a known profile candidate to materialize
         search suggestions. Custom dropdown filling now types its search value character by character
         and recognizes the same role-less option rows before committing and verifying a choice.
         9.6.6 serializes controlled text entry. Ashby persists a field asynchronously on blur, so
         typing nine fields inside one JavaScript task launched overlapping updates and stale responses
         erased a random subset even though every DOM write logged success. Text fields now form a
         plan that the host types one at a time, waits for, reads back, and retries once before moving
         on. A delayed final outstanding-field scan runs after dropdowns. Exact dropdown option clicks
         count even when Ashby's generated selected-value class defeats the generic visual verifier.
         Location autocomplete candidates are typed before discovery and unrelated menu text is
         rejected unless it shares a meaningful token with the saved candidate location.
         9.6.7 adds a bounded second pass for backend-driven autocomplete fields. A failed primary
         value materializes the site's candidates; those exact options and the failure are sent to
         the same ChatGPT answer conversation once, then only unresolved fields are refilled. Each
         queue item persists that answer conversation's /c/ id and URL as soon as it exists, plus
         correction state, so restart/retry can reopen the same answer context. Search text no longer
         makes an uncommitted combobox look answered.
         9.7.0 introduces explicit application-flow adapters for Greenhouse, Ashby, Lever,
         ApplyToJob and Teamtailor, selected specific-first from the URL with Default as the final
         fallback. Each owns its apply-entry, action and validation-error selectors. The selected
         adapter now runs non-submitting validation, advances safe intermediate Next/Continue steps,
         and stops at final Submit. An observer catches errors rendered after the human clicks final
         Submit and sends them back through refill/correction rather than treating the application as
         successful. A minor because apply-flow selection and multi-step validation are new behavior.
         9.7.1 standardizes dropdown activation across extraction and filling: pointer/mousedown,
         explicit focus, pointer/mouseup and click, followed by focus on the revealed search input.
         Option discovery now polls for delayed React menus and reads the complete unfiltered menu
         before typing a candidate, using candidate search only for backend autocomplete fields that
         expose nothing on activation. aria-controls scopes portal menus, and fill-time typing waits
         for asynchronously mounted search inputs instead of accidentally focusing Name or Email.
         9.7.2 fixes Greenhouse dropdown discovery stalling until a user clicks outside. A menu whose
         option set is stable now terminates even when its widget reports a non-advancing scroll range,
         and every menu is dismissed with an outside click before the next field. Discovery and fill
         are scoped to the activated control's ARIA-owned or newly shown menu, preventing job-description
         list items from being mistaken for options. Placeholder text such as "No options" is no longer
         used as a server-backed autocomplete search candidate.
         9.8.0 adds grouped single-select buttons to the entire form pipeline. Native radios hidden
         behind visible labels, role=radio controls, and aria-pressed button groups now contribute
         their exact options to ChatGPT, accept an exact returned answer, and participate in final
         outstanding-field validation. Settings gains an explicit salary/compensation expectation;
         it is included in application reference data and otherwise remains blank for human review.
         A minor because this supports a new control family and a new persisted application default.
         9.8.1 recognizes Ashby's role-less yes/no wrapper. It owns its aria-pressed buttons through
         the surrounding data-field entry so the question label is retained, excludes the hidden
         checkbox that merely mirrors button state, and clicks the exact visible Yes/No answer.
         9.8.2 carries validation failures into the second ChatGPT answer pass. Errors from primary
         validation and the human's final-Submit attempt retain their question/message association,
         asynchronously rendered errors are polled, and correction payloads include text and button
         fields as well as dropdowns, with primary answer, exact error and available options.
         9.9.0 commits grouped choices and custom-dropdown selections through WebView2 browser-level
         mouse/key input so controlled Ashby/React forms update their internal submission state, not
         just their rendered value. After each primary or correction fill, the selected apply adapter
         clicks final Submit, polls for structured site errors, routes failures into the one correction
         pass, and advances the queue when submission is confirmed. Ambiguous results remain reviewable.
         9.9.1 keeps the failed-question inventory until the correction refill actually runs, and
         force-recommits those controls even when their old answers still look selected. Text entry now
         uses WebView2 browser input; rejected choice groups transition through another option and back
         to the requested answer before resubmission; answered custom dropdowns can also be force-filled.
         9.9.2 recognizes Ashby native same-name radio groups that have no fieldset or ARIA group by
         using their one-field data-field entry as the group boundary. Long question labels retain their
         full eligibility notes so extraction, GPT answer keys, filling and correction all agree.
         9.9.3 makes the site action authoritative for correction scope. The adapter physically clicks
         Next or final Submit before reading validation, captures only errors rendered by that action,
         and sends only those rejected questions to GPT. The speculative DOM outstanding scan remains
         diagnostic and no longer expands the second-pass payload.
         9.9.4 fixes two faults found by driving the live Greenhouse form in WebView2. scrollIntoView
         animates when a page sets scroll-behavior:smooth, so the rectangle read on the next line was
         the position before the scroll landed: the LinkedIn field targeted y=1017 in a 900px window,
         the click fell outside the viewport and every keystroke after it went nowhere, reported only
         as "value did not persist". Every scroll before a click is now instant, a target resolving
         off-screen or under another element says so instead of being clicked blind, and verification
         accepts a value the field reformatted — a phone widget appends a space, and an exact string
         compare sent a correctly filled field to human review.
         9.9.5 verifies before it retypes, and stops a click from opening a file dialog. A correction
         round used to refill every field and only then commit the form, spending its single retry on
         fields the site never rejected and overwriting good answers before they could be read; it
         now commits first, reads the errors, and retypes only the fields named in them — and skips
         re-attaching the resume, which makes a controlled form rerender and drop what was typed.
         Separately, any click target that is, contains, or labels a file input is refused: the
         operating system picker it raises blocks the run until a human dismisses it, which is why
         extraction appeared to hang at the resume upload and freed itself when another area was
         clicked. The DevTools attach calls are also bounded, so an unanswered one reports instead
         of stalling.
         9.9.6 corrects 9.9.5 and closes what a full read of the flow turned up. The verify-then-
         retype change was added to FillApplicationAutomatically, which only ever runs the first fill:
         a correction round arrives on ApplicationRefillRequested, where the order was already right,
         so that branch was unreachable and is removed. Two silent dead-ends remain closed by this
         release instead — corrected answers returning for a link that has left the queue, and a
         refill arriving after the queue moved on, both of which used to abandon the round with no
         error and nothing to retry. Validation now also says so when it can locate neither Submit
         nor Next, because a form that was never committed reads afterwards exactly like one that
         passed.
         9.9.7 removes the 47-second stall in extraction. A search-first menu — Greenhouse's Location
         (City) — renders no options at all until a term is typed, and the option-discovery loop's
         early exit required at least one option, so it spent its whole 500 x 80ms budget waiting for
         options that only ever appear in the search phase that follows. An unchanging empty list now
         ends the phase like any other, cutting one field from forty seconds to about two. Custom
         dropdowns are also no longer reported filled merely because a click was dispatched:
         verification polls for the menu to close and the value to render, and a dropdown that never
         confirms is left in the review list. Four dropdowns in one run were counted as filled by a
         run whose own verification said they were empty.
         9.9.8 answers screening questions instead of leaving them blank. A required option question
         that the reference data does not settle now takes the option that keeps the application
         eligible — consent, availability, willingness and acknowledgements are the applicant's own
         choice, and an empty answer is a rejected application. The prompt states the direction
         explicitly, because the eligible answer is not the word yes: consenting to a background check
         is yes, requiring visa sponsorship is no. Checkable claims the reference data does not make —
         work authorisation, a degree, a licence, a clearance, employment dates — are still returned
         empty for a human, since passing a filter by asserting one of those is a misrepresentation
         the applicant would have to stand behind. Applies to the first pass, the correction pass and
         the manual prompt alike.
         9.9.9 stops an open question coming back blank. Asked for a credit-model example this person
         has no credit work for, ChatGPT declined outright and returned an empty string, which is the
         one answer that guarantees the application is never read. The prompt now rules that out: an
         open question is answered from real work in two to five concrete sentences, and where it
         names a domain the person has not worked in, the closest genuine work is described with the
         domain stated plainly rather than claimed or refused. Fabricating an employer, a project or
         a credential stays forbidden. Answers must also be plain text — a markdown link was being
         typed into an email field — and any that survives is unwrapped to its visible text. Questions
         answered blank are now named in the trace and in Activity as they arrive.

         9.9.10 stops reworking fields that were already right. Every fill pass reconsidered the whole
         form, and the core identity selectors — name, email, phone, LinkedIn — wrote unconditionally,
         with no answered check at all, so the correction pass that runs after a validation error
         selected and retyped fields nothing had complained about. That is seconds per field and a
         real risk: a controlled input that drops a retyped value turns a correct field into an empty
         one. The host now keeps a ledger of fields it typed and read back, per page, and the fill,
         choice and dropdown planners all skip them. A field leaves the ledger only when the form
         reports an error against it, when a correction pass forces it, or when the page or step
         changes. What was held back and what was released is named in the trace.

         9.10.0 stops tailoring resumes to the application form, and puts a checked contract between
         every step. The job description was document.body.innerText of whichever page had loaded,
         accepted if it cleared 180 characters. Ashby serves the posting and the form at two
         addresses and an aggregator link points at the form, so for those links the "job
         description" was the contact fields, the demographic survey and the cookie banner - 2,857
         characters on Absci, comfortably over the floor, and nothing downstream could tell. The run
         now goes to the posting URL first, reads the description container rather than the body, and
         judges it by structure: prose in a block with no form controls in it. Absci s posting gives
         5,038 clean characters; its form page is refused because the best block on it holds 36
         controls. Around that, each step of a bid declares what it needs and what it promises -
         navigation, description, form opened, questions, answers, resume PDF, fill, validation - and
         both ends are checked. A step that produces the wrong shape ends that link with what was
         expected and what arrived, and the queue takes the next one, because unusable data is worse
         than no data once it flows on.

         9.11.0 stops a batch waiting on a person, at both ends of it.

         A link whose description could not be read is no longer failed - it is set aside, the run
         carries on to the end, and the links it set aside are then worked through together with a
         person present: the posting opens, they highlight the description, and the normal flow
         resumes from there. One awkward page used to be able to interrupt a batch; now it costs a
         few seconds at the end of one. Deferrals are deliberately kept out of the consecutive-
         failure count, because nothing is wrong with the machine when a page simply lays its
         description out somewhere new.

         And a finished application no longer holds the queue still. It parks in its own tab and the
         run starts the next link immediately, so reviewing - a minute or two of close attention per
         application - happens against a batch of tabs whenever the reviewer is ready, instead of
         once per link the moment each one lands. Generation stays strictly sequential, because it
         is driven through the ChatGPT UI and there is one of those; only the reviewing overlaps.
         Parked tabs are capped (MaxReviewTabs, default 4) since each is a live browser holding a
         rendered page: at the ceiling the run pauses, and closing any tab starts it again. Hidden,
         never Collapsed - a collapsed WebView2 is arranged at zero size and every visibility test on
         the page then reports false, which is exactly what lets a hidden tab keep being filled.

         9.11.1 keeps a continued resume chat honest, and surfaces the review-tab limit.

         Reusing a chat means sending the job description alone, because the profile prompt is
         already at the top of that conversation - which only works if we know which conversation.
         ChatGPT assigns the /c/ id after the first reply and the capture can come back empty; the
         run then believed it had a chat, sent a bare job description, and with no URL to navigate to
         sent it wherever the pane was last pointing, which after the questions step is the previous
         job s answer chat. The resume came back tailored by a conversation that had never seen the
         resume prompt, which looks plausible and is wrong. A chat with no captured URL is now no
         chat: the next request starts a fresh one and sends the prompt with it. The submit path
         refuses the same case outright rather than typing into whatever is on screen, because the
         failure is silent. The trace now names which of the two was sent.

         MaxReviewTabs was added to the settings file in 9.11.0 and never to the settings screen, so
         the only way to change it was to edit JSON. It is on the Application defaults card now.

         9.11.2 makes Stop actually stop, and closes a gap 9.11.0 opened.

         Stopping the queue set a flag that only decided whether a next link would be opened.
         Anything already running carried on, and the longest of those is the wait for a ChatGPT
         reply - three minutes. Stop appeared to do nothing, then produced a timeout alert for a run
         that had been abandoned minutes earlier. Stop now cancels the in-flight work as well, which
         means reaching into the ChatGPT workspace, since that is where the wait lives.

         The other one was mine. Tabs made browsers arrive on demand, and the request for one was a
         plain event: the handler returned at its first await, so navigation could start before the
         browser existed and fail with "the job browser is unavailable" - most easily after a failed
         run, where starting again disposes the old tab before making the new one. Tab creation is
         awaited now. The browser property also no longer throws when there is nothing yet; it hands
         back an uninitialised control so the CoreWebView2 == null guards all over this file can
         answer the question they were written to ask.

         9.11.3 carries no code change. It is a version marker, so the next run can be identified
         from the title bar as the one that came after the 9.11.2 fixes rather than being confused
         with a build that predates them.

         9.11.4 checks that a remembered resume chat actually opened before typing into it.

         9.11.1 stopped a continuation being sent when no conversation URL was known. It did not
         cover the case that turned up in practice: a URL that is known and dead. The run navigated
         to the remembered chat, ChatGPT answered "unable to access this tab", and the bare job
         description went in anyway - so the whole prompt ChatGPT received was "Job description:"
         followed by the posting, with no profile prompt above it. The reply looks like a resume and
         is not the one the profile asks for.

         Arriving is now checked separately from navigating. Existing messages are the test that
         counts: the URL can still read /c/ and the composer can still be there on a conversation
         that failed to load its history, and the history is the entire reason a continuation is
         allowed to send the job description alone. When the check fails the driver opens a fresh
         chat and sends the full prompt, which it now carries on every request for exactly this
         moment, and the generation counters move to the new chat.

         9.11.5 stops the prompt being typed into the previous reply, and finishes a form the site
         will not comment on.

         The submit script took the first visible text input in document order. The transcript is
         above the composer, so a reply left open for editing - an editable wrapper holding the last
         generated resume - captured the next prompt instead. The job description went into the old
         answer, nothing was sent, and the run stopped there with no way forward. Anything inside a
         conversation turn is now excluded from both the input and the Send button, the composer is
         addressed directly, and where it has to be guessed the last candidate wins rather than the
         first, because the composer is below the transcript and a message editor is inside it. An
         open editor is closed and the submit retried, since ChatGPT will not take a new message
         while one is up.

         Second: Submit can land and produce neither a confirmation nor an error. The correction pass
         only ever ran on site errors, so in that case a form with known-empty fields went straight
         to a person untouched. Those empty fields now drive the second pass when there is no other
         evidence. They are matched against the question inventory on the way through, so protected
         and demographic fields - which have no entry there - still cannot reach ChatGPT.

         9.11.6 takes the reply and not what the free plan puts under it. The extraction read the
         whole assistant message, which on a free account carries the Copy/Rate/Retry row and then an
         advertisement below it. Both went to Word as part of the resume, and because an ad rotates on
         its own the text never held still - so the wait for a settled reply ran its full three
         minutes and the run stopped. The rendered message body is now what is read, and where no
         named container exists the children are kept only up to the first one holding a button,
         which is the action row. The test is structural rather than word-matching, because a resume
         is allowed to contain the words Retry or Copy. This covers the answers reply too; both go
         through the same snapshot.

         9.11.7 removes the trip back to the resume chat. After the answers were collected in their
         own conversation, the run navigated back to the resume conversation before handing to Word.
         It was housekeeping - the answers were already in hand - but it was awaited, and a
         navigation that never reports completion costs 45 seconds before giving up. That wait sat
         between the answers and the Word handoff: the pane shows the resume chat, nothing appears to
         happen, and the run reads as stuck. Nothing depended on it. Every operation that follows
         navigates somewhere explicit first - the next resume request to its conversation or a fresh
         chat, a correction to the answer conversation - so where the pane is left is not an input to
         anything, and the handoff to Word now happens immediately.

         9.11.8 sends the prompt instead of only typing it. Submitting depended entirely on finding
         an enabled send button; when ChatGPT presented none - which is what happens in the answers
         conversation - the prompt sat in the composer, nothing was ever sent, and the run waited its
         full three minutes for a reply to a question it had not asked. Placing the text and sending
         it are now separate steps. The host presses Enter through the browser input pipeline, the
         way a person does, and treats the composer emptying as the proof it went. The send button is
         consulted only if Enter did not take, and is never assumed to exist. A prompt that does not
         land in the composer at all is retried rather than sent blind, and the failure message now
         says the prompt was never sent rather than blaming the input.

         9.11.9 makes the Word step visible and stops it misreporting why it failed. It was one trace
         line - "running macro" - and then up to ninety seconds of nothing, so every Word problem
         looked identical and none could be told apart from a hang. It now traces opening the
         document, invoking the macro, and returning, with the elapsed time.

         The timeout was also wrong in a way that mattered. Everything runs on one COM thread, so a
         request can sit behind an earlier one - a prewarm has its own minute - and a single timer
         covered the queue wait and the run together. A macro could be reported as "Word did not
         answer" having never reached Word at all. Starting and running are now waited on and named
         separately, and the budget for the macro is measured from when it actually begins.

         9.11.10 recovers the COM thread, which is what was actually stuck. The tracing added in
         9.11.9 answered it on the first run: a prewarm queued when resume generation began never
         reached the thread in sixty seconds, and the macro queued behind it never started either.
         Word was not slow - the thread was already inside a COM call from an earlier run and was
         never coming back.

         Recovery only ever killed Word. If the thread stayed blocked, every later request queued
         behind a thread that would never run them, waited out its own timeout, failed, and the link
         was retried into the same dead queue - which is how a queue item reached eight attempts
         without Word being asked to do anything. The thread is now replaced as well, in both timeout
         paths, and a work item that never starts is treated as proof of a blocked thread rather than
         a slow one, because nothing else explains it. The abandoned thread is left blocked; it is a
         background thread nothing can free, it costs one thread until exit, and a generation check
         stops its backlog running if it ever wakes. The permanent-wedge state is gone with it: there
         is no longer a condition the service cannot come back from without a restart.

         9.11.11 makes Stop stick. It set a flag saying whether a next link should be opened, and
         three places set that flag straight back - a fill finishing and parking its tab, a tab being
         closed, an application being marked submitted. Any step already in flight when Stop was
         pressed therefore restarted the queue the moment it completed, so the run carried on as
         though nothing had been asked. An intention outlives the step that was running when it was
         expressed: Stop is now remembered until the operator starts something themselves, and every
         continuation point checks it. Opening the next link is refused at the one funnel they all
         go through. A resume that finishes after Stop is kept - it is generated and saved either way
         - but it no longer starts filling a form; that link goes back to the queue instead.

         9.12.0 moves the resume output root, the generated file base and the salary answer off the
         machine and onto the profile. They were global, which was wrong in the same way a global
         macro name would be: the macro that writes the file is this profile s macro, so the folder
         it writes into and the name it saves under describe that document. Salary is an answer a
         person gives, which is the same argument. All three now sit on ds_profiles beside
         word_doc_path and macro_name, and are edited on the profile rather than in Settings.

         Moving a setting without moving its value would have quietly emptied a working
         configuration, so the old machine-wide values are handed to every profile that has none and
         then cleared, leaving one home for each. A profile that already had its own keeps them.

         Requires: ALTER TABLE ds_profiles ADD COLUMN resume_output_root text NOT NULL DEFAULT , 
         resume_output_file_base text NOT NULL DEFAULT Resume, salary_expectation text NOT NULL
         DEFAULT .

         9.12.1 keeps one Word running instead of one per attempt. Word launched for automation is
         invisible for its whole life and only ever quits through CloseWord, which needs a working
         COM channel and a live COM thread; every route that loses either - a wedged call, a
         recycled thread, a crash - left a fully grown Word behind holding its document open, and
         nothing ever collected them. Twenty-seven were running when this was found, the oldest two
         days old, about four gigabytes between them. That is also why the COM thread wedged: the
         next run had to get its call answered by a machine in that state.

         EnsureSingleWordInstance ends every hidden Word the app is not currently using, and runs at
         startup, before a new instance is launched, and whenever the COM thread is abandoned - which
         now takes its Word with it rather than orphaning one more. A Word somebody is using has a
         window and is never touched; that test is what makes the sweep safe, so it is checked first
         and anything that will not answer is left alone.

         9.12.2 stops a continued chat timing out where a fresh one succeeds. Waiting for a reply
         tested whether the number of assistant messages had grown, which holds on an empty
         conversation and does not hold on one being continued: ChatGPT drops older turns out of the
         DOM as the transcript grows, so the count can stay level or fall while a good reply streams
         in below it. The wait now watches the last message text change instead, which is the part
         always mounted, and keeps the count only as a second signal.

         The wait also says what it is waiting for every fifteen seconds, and on giving up says which
         of the two happened - nothing ever arrived, or something arrived and was refused each time
         for its shape. Three minutes of silence ending in a failure explained neither.

         9.12.3 stops a handoff between the two workspaces failing in silence. Every one of them was
         "_ = SomeAsync(...)": started, never awaited, never looked at again. A task that faults
         there disappears completely - no log, no status, no failed work item, nothing to retry - and
         the run stops where it stood, which is indistinguishable from a hang. That is what happened
         after the corrected answers came back: the corrections arrived, the handoff threw, and the
         exception went into a task nobody held. All six now report what broke and leave the link
         alone so it can be retried.

         One cause is fixed outright. Answers were collected with ToDictionary over a case-insensitive
         comparer, which throws when two keys collide - and those keys are question text written back
         by ChatGPT, so a collision is something the model can hand us at any time. The dictionary is
         built by assignment now and the later value wins: losing one answer beats losing the set.

         9.13.0 reworks the application tabs and refines the theme.

         A tab was a full-width button carrying a title, a dot and a status line, and the title was
         the host plus the last path segment - which on Ashby is the posting UUID. Sixty characters
         saying nothing is what made a row of tabs span the pane. Tabs are chips now: one line, a
         capped and trimmed title, the status moved to a tooltip, and the selected one filled with
         the primary blue in white text while the rest stay on surface white. Titles name the
         employer, taken from the first real path segment or a Greenhouse "for" parameter, and are
         title-cased - "Absci", "Empirical Security" - with the host only as a last resort.

         The theme itself: the window now sits a shade warmer than the cards so a card reads as
         raised without a shadow, which is deliberate on a page hosting two browsers. Text has three
         deliberate levels, the primary is a deeper and less electric blue that can carry white text
         on a chip, status colours are pulled back from their pure hues, and body copy has a real
         line height. Segoe UI Variable is used where Windows 11 has it, named once so a change lands
         everywhere rather than in twenty views.

         10.0.0 takes the database out of this app.

         Every install used to hold the portal's PostgreSQL password, open its own connection, and
         issue its own SQL - including verifying app_user.password_hash here, in C#, a hand-port of
         the portal's scrypt that nothing kept in step with the original. One app was doing the
         server's job, and it cost three things at once: a credential with rights over the whole
         team's data sitting in cleartext on every laptop; an authentication rule implemented twice,
         so a change made in the portal never reached here; and the ds_* tables owned by nobody,
         created by hand from a .sql file this app shipped but refused to run.

         The app now signs in at /api/devstrider/auth/login and reads and writes everything through
         /api/devstrider/*. Gone from this project: Npgsql, BouncyCastle, Data/Postgres,
         SharedDbContext, SharedDbCredentials, the six DEVSTRIDER_SHARED_DB_* variables, and the
         database panel on the login window and in Settings - one URL replaces all of it, and the URL
         is not a secret.

         Sign-in returns a token good for a week, kept in %LOCALAPPDATA%\DevStrider\session.dat
         under DPAPI. So there IS a persisted session now, where there deliberately wasn't before:
         the reason there wasn't is that the only thing worth persisting was a database password.
         What is kept instead is scoped to DevStrider, expires on its own, is re-checked against the
         portal at every launch, and renews itself inside its last day - so the sign-in window is
         something you see when you set a machine up, and about once a week after that.

         One bug worth naming, because it broke every single call and was invisible in review:
         PortalApi joined its base address to a path as Uri + string, and Uri.ToString() re-adds the
         trailing slash - "https://host" + "/api/me" came out "https://host//api/me", which is a
         different number of path segments, matches no route, falls through to the static handler and
         redirects. The joined form is text now, and never carries a trailing slash.

         10.1.0 adds a proxy, so DevStrider can run where ChatGPT cannot be reached. The whole app is
         built around driving ChatGPT in a real browser, so from those places it did not work slowly
         - it did not work.

         WebView2 takes its proxy from the arguments its environment was created with, and there is
         no way to move a live browser onto one, which is why the setting says it applies at the next
         start rather than pretending otherwise. The two browsers already had separate environments,
         and that is what makes the default scope possible: ChatGPT goes through the proxy and the
         job sites stay direct, because they are reachable already and an extra hop would be paid on
         the page-heaviest part of every run. Widening the scope routes both.

         The portal is always bypassed, listed or not - signing in is traffic the person can already
         reach, and a session token has no reason to travel through someone else s server. A proxy
         that asks for a password is answered only when the challenge names a proxy, so a job board
         putting up a login box cannot collect it. Test asks the proxy for a ChatGPT URL rather than
         a neutral host, because a proxy that answers but still cannot reach ChatGPT is a different
         problem and worth learning about before a run finds it.

         10.1.2 confines the correction pass to the fields the site actually rejected, and adds a
         Clear list button to the queue.

         The correction pass was already meant to leave correct answers alone, and it had two
         defences that were both inference. The settled ledger remembers what the first pass typed
         and verified - but it is keyed to the page URL and is dropped the moment that key changes,
         and the correction round asks ChatGPT in between, which is minutes. Whatever the ledger no
         longer covers falls through to an "is this already answered?" probe, and that probe has to
         be right about every widget on the page: a react-select whose chosen value lives in a
         sibling div, a radio group whose selected option does not report as selected, a select whose
         real first option sits at index 0. Any one of those reads as unanswered, and the pass
         retypes an answer that was already correct - seconds each, another chance for a controlled
         input to drop the value it held, and on a checkbox the retype clicks the right answer back
         off. Against the saved Greenhouse page, with the ledger gone and one field rejected, the old
         pass planned three fields.

         So the pass is now scoped rather than inferred: the correction round already knows exactly
         which fields it asked about, that list is handed to the fill and dropdown scripts, and a
         control that is not on it is not eligible - whatever the ledger says, whatever the probes
         say. The harness proves the hard case: clear every value on the form so every probe reports
         unanswered, scope to one rejected field, and exactly one field is planned. The ledger stays,
         because it still saves the primary pass from redoing an intermediate step; it is just no
         longer the only thing standing between a correct answer and a retype.

         A scope that resolves to no visible control is now a warning naming what it looked for. That
         case is a real one - a site whose error text names no field the page shows - and it used to
         report zero fields filled, which reads exactly like a form that needed nothing.

         Clear list empties the queue, including mid-run, which is when you want it. Links open for
         review or being worked on right now are kept: the automation is inside one of them, a parked
         tab is a filled application waiting on a person, and dropping either would leave a browser
         tab pointing at a queue entry that no longer exists.

         10.2.0 fixes which box the prompt goes into, opens the app up to be diagnosed from outside
         itself, and stops a run of bad links from ending a good batch.

         The composer bug first. "The composer" was defined by what it is not: not inside a
         transcript turn, not disabled, and failing that, simply the last text input on the page.
         Click Edit on a reply and ChatGPT puts a second real textarea above the composer - visible,
         enabled, and on some builds not inside anything the transcript selectors recognise. The
         prompt went into the open reply, nothing was sent, and the run waited out its full reply
         timeout for an answer to a question it never asked.

         The composer is identified by what it is now. It is the input that sits in a box with the
         attach control, the send button and the model dropdown - furniture that appears once on the
         page, around the real composer and nowhere else. Candidates are scored on how much of it
         they can see. In the harness the open editor scores -3 against the composer's 21, and it
         still loses when it is the last input on the page, when its turn carries no marker at all,
         and when ChatGPT has taken away the composer's id and its test ids. No single signal is
         decisive: any one of them written as a hard requirement is a run that stops dead the week
         ChatGPT renames something.

         Two things made that bug expensive rather than merely wrong. The rule existed in four
         copies that had drifted apart, so the element the text was placed in was not necessarily
         the one the send targeted - all four share one definition now. And the failure said only
         "input not found", which never says what was there. It now names every candidate it
         rejected and why.

         Which is the same reason for the /dev endpoints. Everything hard about this app happens
         inside a signed-in ChatGPT session or a live application form - pages that exist on one
         machine and cannot be reproduced anywhere else - and the only evidence that ever reached a
         diagnosis was a trace line saying something was missing. So: /dev/state, /dev/log,
         /dev/browsers, /dev/composer, /dev/dom, /dev/text, /dev/eval, /dev/shot and /dev/command,
         on the loopback listener that already existed. Script, DOM and a picture, on the real
         session, without attaching a debugger or shipping a build. It is a switch in Settings and
         it is on by default while this is being built; /dev/eval runs arbitrary script in a
         signed-in browser, so it comes off before the app goes to anyone who is not developing it.

         Last, failures. Three in a row stopped the run, and every failure counted the same. A
         posting whose description will not parse says nothing about the next posting; ChatGPT being
         signed out says everything about it. Those are now separate: a link-level failure skips and
         the run carries on however many there are, and only a machinery failure counts towards
         stopping. Reaching review resets the count, so the limit means three failures with nothing
         working in between.

         The endpoints then found something on their first outing, which is the argument for them.
         Pointed at the Lyft form that had just failed, the app's own matcher reported it would put
         the applicant's full name into Company name. The alias "name" is four characters and matches
         by containment, so it sat inside "company name" - and inside "school name", "reference
         email", "manager phone" and "emergency contact phone" too, every one of them answered with
         the applicant's own details. Containment now stops at a label naming another party;
         an exact match still goes through. Confirmed against the live form: seven fields filled
         became six, and the employer's box was left for a person.

         10.3.0 comes entirely out of running the automation against the live app and reading what
         came back. Nine defects, every one found by watching a real run rather than reading code.

         The worst: applications were submitted with required fields unanswered. A run filled seven
         fields on a Greenhouse form, logged "leaving it for review" against nine more - Country,
         Location, work authorisation, years of experience - and then clicked Submit anyway. The job
         site accepted it. Nothing reviewed anything, and a submission is not recoverable. Final
         Submit is now refused while any field the form marks required is still unanswered; the
         application parks for review with the list. Required is read from the form itself, after
         typing, not from the pre-typing snapshot the fill script returns - wiring it to that
         snapshot made the gate refuse forms it had just filled, naming Full name and Email as empty
         moments after verifying both.

         Underneath that sat the reason those fields looked empty. Element.closest() matches the
         element itself, and a react-select control IS an <input role="combobox">, so every lookup
         for the rendered chosen value resolved to the input - which has no children. Dropdowns that
         had been set correctly reported as unanswered in four places at once: the verify probe, the
         outstanding list, the plan, and the fill. A parked tab showed select__single-value reading
         "Cuautitlán Izcalli, México, Mexico" while the trace insisted that field was empty. One
         shared helper now walks up from the control, stopping before an ancestor holding a second
         combobox so it cannot read the neighbouring dropdown's answer.

         The commit script also crashed outright on any form where the menu was not open:
         controlledId is '' with no aria-controls, ''.split(/\s+/) is [''], getElementById('') is
         null, and visible(null) threw. WebView2 reports a thrown script as the bare string "null",
         so the host read a crash as "no option matched".

         Two silent stalls. A resume arriving after its tab had been released hit a bare `return` -
         the item sat in "Generating resume" for ever with the queue still marked running, no trace,
         no failure, no retry, and a finished resume thrown away. It re-opens the tab now, and says
         so if it cannot. The correction path had the same dead end.

         Two ways one bad ChatGPT reply became many. A continuation sends the job description alone,
         and by the fifth turn ChatGPT had stopped using the [Section]: labels the Word macro needs -
         the format instruction was eight messages up. Continuations restate the contract now,
         naming no labels because each profile picks its own. And a failure only abandoned the
         conversation if it had just started it, so a drifted chat stayed in place and took the next
         link down the same way, three in a row, until the run stopped on what looked like a
         machinery streak and was really one conversation going bad.

         Also: concurrent saves shared one settings.json.tmp and the loser got "the process cannot
         access the file", surfacing mid-run as lost corrections; and ChatGPT's hidden accessibility
         textarea could out-score the contenteditable for one render, costing a wasted attempt per
         prompt.

         Verified on the live app after the fixes: a Beacon Biosignals application filled with 8
         fields verified and 0 outstanding, both dropdowns confirmed by their rendered values, and
         submitted clean - while the Lyft form next to it was correctly refused, its unanswered list
         down from fourteen fields to the four nobody can answer.

         10.4.0 narrows what the second pass asks about, keeps the tab after a submission, and stops
         the answer prompt refusing the questions that decide whether an application is read.

         The prompt first, because it was contradicting itself. One paragraph said a required
         question with options must never come back empty; a later one said never to assert an
         unstated eligibility fact and named work authorisation among them. The second won: "Are you
         legally authorized to work in the country where this role is based without restriction?",
         options Yes and No, came back as "". A blank there is not the cautious answer — the
         application ends unread, which is the same outcome as an ineligible answer and has no
         upside, and applying for the role is itself the claim that you can hold it. Eligibility
         facts now come from the reference data where it states them and take the eligible option
         where it is silent, in all three prompts, which had drifted apart. The absolute refusal is
         unchanged: government ID, national-insurance number, passport, licence, bank or card
         details are never answered.

         The second pass was carrying every empty field on the page. A live run sent GitHub URL,
         Portfolio URL and Other website to ChatGPT and got three blanks back, having spent a round
         trip on questions the form was happy to leave empty. The site's own errors drive it when
         Submit produced any; when Submit produced no verdict at all, only required-and-empty fields
         do. Fields that are empty and optional are now named in the trace and asked about by nobody.

         And "submitted" is not the end of an application. Some sites e-mail a code and ask for it on
         the same page; all of them show a confirmation worth reading. The tab used to close the
         instant the site said submitted, which threw that away along with any chance of finishing a
         two-step submission. It stays now, holding whatever the site is showing, and closing it is
         what files the queue entry and frees the review slot.

         Verified live on the question that started it: two options read off the control, "Yes"
         chosen on the first pass and confirmed in the DOM, nine fields verified and none
         outstanding, submitted clean — with no correction round at all — and the tab left open on
         "Thank you for applying. Your application has been received."

         10.5.0 gives the review tabs their two actions, and lets the correction pass press Submit.

         Ctrl+click a tab — or right-click it — opens Mark submitted and Remove from the list. The
         gesture opens the choice rather than making it: a modifier that acted on its own would put
         "remove this application" one slip away from a plain tab switch. Marking a tab that is
         already submitted is refused rather than counted twice, which it could be now that a
         submitted tab stays open.

         The submit gate was absolute, and on the second pass that was one refusal too many. The
         first pass still holds back — there is a correction round to come, and submitting an
         application known to be incomplete is the thing 10.3.0 exists to stop. But once that round
         has been spent, everything answerable has been answered, and from there the site's verdict
         is worth more than ours: a rejection names the real problem, while our "required" is
         inferred from an asterisk. So the correction pass submits, and when it goes through with
         fields this app still read as required and empty, that is said out loud in the note and the
         trace rather than filed as a clean submission — one of the two readings is wrong, and only
         one of them is recoverable.

         Verified live on Natera: the first pass held back naming street address and Postal Code,
         the second pass asked about exactly those two and nothing else, and after the refill it
         pressed Submit with one field still outstanding and flagged it. Two other applications went
         through the same run at 16 and 13 fields verified with nothing outstanding and no correction
         round at all.

         10.6.0 fixes two ways a bid could report success without producing anything, and clears out
         four pieces of accumulated friction.

         The worst one first: a run could attach a resume written for a different job. The file
         resolver fell back to "newest folder written in the last ten minutes", and ten minutes is
         several jobs in one run. With no [FolderName]: line at all it walked into the previous
         application's folder, found a real PDF, and reported a successful generation. Freshness is
         the test now, not existence: the moment the macro starts is passed in, and only a folder and
         a file written after it count. Its sibling: when nothing was produced at all the run said
         "Resume generated", handed an empty path to the job browser, and filled and submitted the
         form with no resume attached. A bid without its resume is a failed bid and is reported as
         one.

         Both were fed by the resume chat. The conversation URL is remembered across restarts; the
         count of resumes already written in it is not. Every launch therefore resumed an old chat
         believing it was 0 of 10 used when it might hold forty, and a chat that long has the
         [Section]: format instruction far above the fold — ChatGPT stops using it, the reply is a
         fine resume the Word macro cannot read, and no resume gets made. A session starts a fresh
         chat now, which costs one profile prompt and is the only honest reading of a counter that
         starts at zero.

         Then: Submit is pressed after every fill, because the site's answer is the review material
         and its rejection names what is wrong far better than this app's reading of the form. Where
         a required field still looks empty from here that is said out loud rather than used as a
         reason to stop. The review ceiling is gone. Applied links leave the queue, while their tab
         stays for the confirmation. Screening questions — work authorisation, sponsorship, visa,
         background check, relocation, notice — are chased even when the form leaves them optional,
         because a blank there loses the application as surely as an ineligible answer would. And one
         answer chat now serves three applications rather than one, so a batch of thirty stops
         leaving thirty conversations behind.

         Verified on a live run: five applications through two answer chats instead of five, each
         resume resolving to its own job's folder, the eligibility questions on Lumanu and BJAK
         picked up on the second pass, two clean submissions, and their links gone from the queue
         with the confirmation tabs still open.

         10.7.0 finds the Submit button on forms that had none, and records the job board rather than
         ChatGPT as where a bid came from.

         Submit was located only through each adapter's selector list, and on Ashby every one of them
         missed: its Submit sits outside any &lt;form&gt;, carries no type="submit" and no
         role="button", so "form button", "button[type='submit']" and "[role='button']" all found
         nothing. The candidate list came back empty, the action was "none", and the run filled a
         complete application and never committed it — no submission, no errors, nothing to correct.
         A selector list is a guess about markup; there is a backstop now. When the adapter finds
         nothing, every pressable thing on the page is read and matched on its text, and the
         bottom-most match wins, because the real Submit is the last thing on an application form.

         That backstop needed to be narrower than the adapter matcher, not wider. "Apply" is a safe
         word while the search is confined to form buttons and dangerous the moment it is not: an
         embedded Greenhouse posting keeps an Apply button above the form, so the first version of
         this matched it on the confirmation page, called a finished submission "still needs a final
         click", and probed fourteen times for something that had already happened. The page-wide
         reading takes submit and send/complete/finish application, and never a bare apply.

         A Submit that exists but is switched off now reports as blocked rather than as absent. The
         two are different problems and they read identically before.

         Origin recorded "ChatGPT UI" on every automatic bid — how the resume was written, which says
         nothing about the posting. It is the board now: Ashby, Greenhouse, Lever, or the site's own
         host with the careers/jobs/boards subdomain trimmed so one company reads as one source.

         Verified live: Ashby's Absci form, which had never once been committed, clicked Submit and
         came back with the site's own "Education history is invalid"; a Lever form clicked Submit,
         returned "Current location: Please fill out this field", drove a second pass on that one
         field and submitted again; and two Greenhouse applications went through clean.

         10.8.0 makes suggestion fields work — the kind that will not keep a typed value and only
         accept an option you pick.

         Lever's Current location is one. It is a plain input[type=text] with no combobox role and no
         aria-autocomplete, so it went to the text pass, which typed into it, watched Lever clear it
         on blur, reported "value did not persist", and left the application to be rejected for an
         empty required field on every attempt, forever. The real answer goes into a hidden partner
         input that only a picked option fills.

         That hidden partner is the tell, and it is markup-shaped rather than site-shaped: a field
         block holding one visible text box beside a hidden input whose name says it holds the
         selected value is a control that demands a choice, whatever it looks like. Those now join
         the dropdown pass, which already knew how to type, wait for a list, choose and read back —
         precisely the sequence one of these needs and precisely what the text pass cannot do. Their
         answer is read from the partner rather than from a rendered value element, in the plan, the
         outstanding list and the verify probe alike.

         Two general bugs surfaced underneath, both of which had been quietly costing picks on every
         site. norm() stripped accents as punctuation, so "Cuautitlán" became "cuautitl n" and a
         typed "Cuautitlan" matched nothing a Mexican city returns; accents are folded now, not
         deleted. And option matching demanded equality, while a suggestion list answers a partial
         query with a fuller string — type "Cuautitlan Izcalli", get "Cuautitlán Izcalli, México,
         MEX". Equality still wins where it exists, with prefix and containment behind it, each
         carrying a length floor so a two-letter query cannot select a country.

         Verified live on the posting that had never once got past this field: the option picked,
         Lever's hidden selectedLocation holding the chosen city, Submit clicked, and the site
         answering "application submitted".

         10.9.0 stops the app sending the one answer that ends an application, and stops a menu
         moving out from under the click that was meant to choose from it.

         The first is the serious one, and nothing was broken in the filling. A live run answered
         "Will you require sponsorship for US employment visa status now or in the future?" with Yes,
         clicked it, verified it as selected, and submitted. The answer itself was the end of the
         application. Direction is the whole difficulty with these questions — "are you authorised to
         work here" and "will you require sponsorship" want opposite words for the same underlying
         fact — and it is exactly what a model gets wrong, in one direction, under a prompt that
         spells out what to do. Screening answers are now checked before they are typed: where the
         one we hold is the disqualifying one, the eligible one goes instead and the substitution is
         traced. It keys on the verb rather than a list of phrasings, because the phrasings are
         endless and the verb is what carries the direction; it corrects only yes/no answers, never
         invents one where none was given, and leaves alone any question that reads both ways.

         The second: Ashby's Location and School were typed, matched to the right option, clicked,
         and left unpicked, so the form was rejected for a required field whose answer was visible on
         screen at the time. The commit script scrolls the option into view and measures it in the
         same synchronous task, but a floating menu repositions a frame or two later and the click
         happens on a separate round trip after that — Location came back at y=122 for a menu that
         settled at y=400, so the click landed on the page behind the list. The option is stashed
         now and its position re-read immediately before the click, and the whole pick gets a second
         attempt when the first does not take.

         Verified live: the sponsorship question corrected from Yes to No, clicked and confirmed
         selected, on the Absci form that had been failing on it — and that application submitted.
         The retarget step is built and traced but the queue ran dry before a form with an Ashby
         location dropdown came round again, so it is not yet confirmed on a live run.

         10.10.0 recovers answers that were being thrown away, and stops a retry filling nothing.

         A question that quotes one of its own options — If you selected "Location not listed" above,
         tell us where you intend to work — comes back as a JSON key holding bare double quotes,
         because ChatGPT echoes the question text as it was given. That is not JSON, so the parse
         failed, so every answer in the reply was discarded: sixteen good answers lost over one
         question's punctuation, three minutes spent re-reading the same reply, and the link failed
         as a format violation. JSON cannot tell a closing quote from a literal one by looking at the
         quote, but it can by looking at what follows: a string ends only where the next thing that
         matters is a colon, comma, brace, bracket or the end of the text. Anywhere else the model
         forgot an escape, and the reader puts it back. The prompt asks for the escaping too, which
         costs nothing, but the reader is what makes it not matter.

         The second was hiding behind the first. The settled-field ledger — the record of what this
         app has already typed and verified, so later passes leave correct answers alone — was keyed
         on the URL. A retried link loads the same address a second time with every field empty
         again, and the ledger still said all fifteen were done: the run skipped every one, filled
         nothing, and failed the link for having nothing to submit. It carries a marker in the page
         now. A reload takes the page's globals with it, so the ledger is known to be stale; an SPA
         re-render, which really is the same document, keeps them.

         Verified live on the Thumbtack posting that prompted both: sixteen of sixteen answers
         parsed, the ledger cleared for a fresh document, and a fill that had managed 0 verified
         fields managing 16 — then Submit clicked and Ashby answering with its own remaining
         complaint rather than silence.

         10.11.0 waits for the job site to take the resume before anything else in the run proceeds.

         "Missing entry for required field: Resume" on a form the trace said had the resume attached,
         and then the same link submitting cleanly on the next attempt with no code changed in
         between. That difference is the whole diagnosis: it is a race, not a failure. Setting a file
         input's files is instant, and everything after it is not — Ashby posts the file to its own
         server on the change event and counts the field as answered only once that lands. Whether
         Submit beat it depended on how long the rest of the form happened to take to fill.

         So the run now waits on the site's own evidence rather than on ours. The file sitting in the
         input is our half; the file's name appearing on the page is the site's, and both are
         required. Anything still visibly uploading holds the wait open rather than failing it, and
         when the site never shows the name back the run says so and submits anyway — a resume that
         did land and was never rendered is not a reason to abandon a finished application.

         Verified on the live Ashby form that nothing false-positives: an empty form reports neither
         half, and a word the page really displays satisfies the name check while the empty input
         still holds the wait. The full positive needs an unapplied Ashby posting to land on, and
         every one in the queue had already been submitted by the time this was built.

         10.12.0 releases links an interrupted run was holding, and corrects the resume check that
         10.11.0 got wrong in both halves.

         A status like "Generating resume" describes a browser, a ChatGPT conversation and a Word
         macro that all stopped existing when the app closed. Nothing ever cleared it, and Start only
         picks up "Queued" — so a link killed mid-run sat reading "Generating resume" for ever,
         invisible to the queue and to every retry. Two were stranded that way. Every in-flight
         status is put back in the queue at startup, keeping the attempt count and the last error and
         dropping only the claim that something is in progress. Needs JD and Failed stay as they are:
         those are conclusions a run reached, not work it was in the middle of, and Skipped is a
         person's decision.

         The resume check needed both halves fixed, and the run that exercised those two links is
         what showed it. It matched the file name's stem as well as the whole name, to be forgiving —
         but this profile's resume is Fernando.pdf and the applicant is Fernando, so "fernando" is on
         the form the moment the name field is filled, and the check reported the resume attached
         before it had been. And it required our file to still be sitting in the input, which
         Greenhouse makes impossible: it hands the file to its own uploader and removes the native
         input, leaving no file inputs on the page at all. Both together meant twelve seconds of
         waiting and a misleading warning on every Greenhouse application. The name must now match in
         full, either side of the evidence is enough on its own, and a site showing nothing either
         way is given a few rounds rather than the whole budget.

         Verified live: both stranded links released at startup and announced, then run to completion
         — "resume attached, confirmed on the page", 24 fields verified with nothing outstanding, and
         the application accepted.

         10.13.0 stops the app filing applications as submitted on no evidence, and makes marking one
         submitted mean it is finished with.

         The rule that went: after Submit, if a couple of seconds passed with the button gone and
         nothing else on the page, the application was recorded as accepted. That is not a reading of
         anything — it is silence, and most of a day's runs were filed that way. Only the site saying
         so counts now, in its own words, read off the page. The window to say it went from about
         four seconds to twelve, because a confirmation that renders slowly was previously indistinct
         from one that never came.

         The wording it accepts is much wider — thanks for applying, application received or sent or
         complete, submission successful, successfully submitted, and the confirmation paths. Widening
         it is what makes the guard necessary: a job description that thanks you for your interest,
         sitting above a form still waiting to be sent, matches several of those phrases. So a phrase
         only counts once the form is done with it — while an enabled Submit is still on the page,
         nothing is confirmed.

         A confirmation and a verification code are not alternatives, and a site can show both. What
         decides whether an application is finished is therefore not the wording but whether the page
         still wants something from a person: an empty, enabled field carrying
         autocomplete="one-time-code" or a label that says code, verification, OTP or PIN. Confirmed
         with nothing pending is filed and its tab closed. Confirmed with a code field waiting keeps
         its tab, keeps its place in the queue, is flagged in the activity log, and the run carries
         on to the next link — a code arrives by e-mail minutes later and nothing is served by making
         a batch wait for it. Ambiguity keeps the tab, because closing one wrongly can lose a
         submission for good and keeping one wrongly costs a click.

         Marking submitted now closes the tab, by hand as well as automatically: a submitted
         application sitting in the review list is a thing to read and dismiss that carries no
         decision. Remove from the list stays for the other case.

         The harness caught a bug in this before it ran anywhere: an escaped apostrophe inside the
         phrase list ended its JavaScript string early, which would have thrown on every page the
         validation script touched. Ten cases now cover the real Greenhouse confirmation word for
         word, four other real wordings, a code box found by attribute and by label, a filled code box
         that must not hold a tab open, silence, and the job description that thanks you above a live
         form. Confirmed on the live pages too: the Greenhouse confirmation reads as submitted, and
         the Ashby application form next to it does not.

         10.14.0 adds the box the verification codes go into, and fixes a stall that the live test of
         it exposed.

         The stall first, because it was mine and it was from an hour earlier. Marking an application
         submitted was changed to close its tab, and the method that closes tabs also decides whether
         to restart a run that had paused for a free slot — so it declined to open the next link, on
         the grounds that the queue was already going. It was: it was going nowhere. One application
         submitted, its tab closed, and nine links sat waiting with nothing left to start them.
         Disposing a tab and deciding what the run does next are now separate things, because the two
         callers want opposite answers: a person closing a reviewed tab may be freeing the run to
         continue, while the run closing its own tab is already running and needs the next link.

         Then the codes. A site that confirms an application and then e-mails a code leaves the run
         several links further on by the time it arrives, so the application parks with its tab open
         and the queue carries on. The codes are pasted into one box, aimed by default at whichever
         application has been waiting longest and moving on by itself after each one — so pasting
         them in the order the e-mails land needs no aiming at all. It is a list rather than a queue
         because the e-mails do not always arrive in the order the applications went out, and a code
         typed into the wrong application cannot afterwards be typed into the right one. Entering one
         drives that application's own browser rather than whichever tab the run is on, then asks the
         page what happened: accepted files the application and closes it, rejected says what the
         site said, and neither leaves it where it was.

         The live test: ten links, six submitted on the site's own confirmation, three parked for
         review because no confirmation came — under the rule this replaced, those three would have
         been recorded as submitted on silence. Not tested live: the code entry itself. No site in
         the batch asked for a code, Greenhouse included, so the box has its unit coverage and its
         wiring checked and nothing more.

         10.15.0 lets the app work while nothing is looking at it.

         Chromium assumes it is a browser somebody is watching. When its window is covered, minimised
         or on another virtual desktop it treats the page as unwatched and turns it down: timers
         throttled to about once a second, animation frames stopped, renderer priority dropped. That
         is right for a browser and fatal here, because the unwatched page is the one being driven —
         a form being filled, a ChatGPT reply being waited for. Left in the background a run did not
         go slowly, it stopped, and the only way to keep it going was to leave the window on top of
         everything else.

         Measured before: with nothing in front of it but a terminal, a 100ms interval was firing 0.3
         times a second — thirty times slower than asked — and requestAnimationFrame was not firing
         at all. Four switches at environment creation turn that off: CalculateNativeWinOcclusion is
         the Windows check that decides a window is covered and is what makes "only works on top" the
         rule; backgrounding-occluded-windows is what it does about it; renderer-backgrounding drops
         process priority; background-timer-throttling is the one that stretches every timer out.
         Measured after, same conditions: 10 timer ticks a second, exactly the rate asked for.

         Minimised is the same. The job browser held 10 ticks a second with the window iconified, and
         the ChatGPT browser held 60 frames a second alongside it. Then a real run, minimised
         throughout: three links worked, a form filled, Submit clicked, and an application confirmed
         by the site and filed — all of it through DevTools input, which is synthesised inside the
         renderer and never touches the desktop, so no window has to be anywhere near the front for a
         click to land where it was aimed.

         The arguments have to be passed when the environment is created, so this needs a restart to
         take effect, exactly as the proxy does.

         10.16.0 lets a run take some links and leave others, and adds a one-application mode.

         Job boards do not finish the same way. Ashby and Lever confirm and are done, so a batch of
         those can be left alone; most Greenhouse postings e-mail a verification code afterwards,
         which needs a person and their inbox. Run together, either the whole batch gets babysat or
         the codes go unentered — so the queue now has a tick box per link, buttons that tick one
         board at a time, and a run that only takes what is ticked. Ticking nothing still means all
         of it, because that is what the button meant before and it is still what it should mean.
         Alongside it, "Apply to one, then stop": the application goes out, its tab stays open, and
         the queue does not move on while a code is being fetched by hand.

         Building it turned up an older bug it would otherwise have inherited. The run decided what
         to open next by carrying on with the current item unless that item was submitted, skipped or
         failed — which quietly included "Needs JD" and "Ready for review", so pressing start picked
         up whatever had been left on screen rather than what was queued. Caught live: a single-link
         run aimed at one ticked Greenhouse posting opened an unrelated Ashby link that had been
         deferred an hour earlier. Carrying on is now for an item that is genuinely mid-flight, or one
         a retry has just put back in the queue.

         Verified live both ways: with only Ashby ticked the run took the Ashby link and left the
         queued Greenhouse one untouched, and with only Greenhouse ticked "apply to one" opened that
         link, finished it, and stopped with its tab open.

         10.17.0 checks the browser is on the right job before filling it, and lets a description be
         pasted in for any link that needs one.

         Nothing used to ask which page was open. The fill step asserted only that some http page
         was — so a navigation that quietly did not land left the run filling the previous posting's
         form with this job's answers and submitting it, with no error anywhere and the wrong employer
         receiving it. The page is now identified before a field is touched: one re-navigation, then
         the link fails rather than being filled. Matching is loose about what boards legitimately
         change and strict about what identifies the posting — a Greenhouse redirect from
         boards.greenhouse.io to job-boards.greenhouse.io with tracking parameters bolted on is the
         same job, /application appended to an Ashby path is the same job, and two embed URLs
         differing only in their token are not. Seven real URL shapes cover it, including the two
         that must not match.

         The links whose description could not be read were reachable only during the manual pass
         that runs after a batch finishes, one at a time and in the queue's own order. That is the
         wrong shape for the job: a person with the posting open in another window wants to paste it
         now, for that link. They are listed on their own now, any of them can be given a description
         at any time, and the link goes straight back in the queue afterwards. The run honours a
         description supplied that way instead of reading the posting, which is what makes such a
         link ordinary again rather than a special case that gets re-read and re-deferred. Text too
         short to be a description is refused with the reason, as it always was.

         Verified live: a dead posting's page text — 138 characters of "Job not found" — refused with
         "only 138 characters, select the whole description", and a real 6,000-character description
         accepted, persisted on the link, and the link returned to Queued. -->
    <!-- 10.18.0 stops the app asserting facts about a person that nothing has told it.

         The answer prompts used to say, of citizenship, work authorisation, degrees, licences,
         clearances and employment dates: "where it is silent, still answer, and answer so that this
         application stays eligible". That is an instruction to state unverified things about a real
         applicant to an employer, and it does not even pay: an invented clearance fails the check it
         was invented to pass, so the application is lost later instead of now, with the applicant's
         name on the claim. ApplicationQuestionPolicy now classifies each question — verifiable fact,
         the applicant's own choice, or free text — grounds the first kind in the profile and person
         facts only, and routes anything it cannot ground to Quick answers with the field left blank.
         Enforced twice: a sentinel the prompt asks for, and an independent check on the reply, since
         a model ignoring the instruction is the failure being defended against. Answering in Quick
         answers writes the fact to the profile, so the same question is automatic next time.

         Also in 10.18.0, from a full review of the app:
         · The local listener refused nothing cross-origin and answered Access-Control-Allow-Origin:*
           — so any page the user had open could run the Word macro, synthesize Ctrl+V+Enter into the
           foreground window, or, with developer tools on, execute script in the signed-in ChatGPT
           browser and read the result. Loopback keeps other machines out, not other tabs. It now
           requires a loopback Origin or none at all, and DeveloperTools defaults to off.
         · The bid board shell-executed a row's URL with no scheme check, and ds_bids is team-writable
           — \\host\share\x.exe would have run on click. http/https only now.
         · R2 downloads enforced no extension allow-list (uploads always did), so a teammate-set
           filename of "offer.pdf.exe" would have been fetched and shell-executed. Same list both ways.
         · EnsureSingleWordInstance killed any windowless WINWORD older than 20s, entireProcessTree —
           which is also true of another app's COM automation, of a slow-opening document, and, since
           windows in other sessions are invisible from this one, of other users' Word on a shared
           machine. It now sweeps only pids this app recorded launching, matched on start time so a
           recycled pid is not mistaken for the original. The duplicate startup sweep is gone with it.
         · PendingBidQueue wrote its journal through a fixed .tmp name with no gate, from three
           concurrent paths — the exact collision SettingsStore documents having fixed. Same fix.
         · DevEndpoints' body cap was checked only against Content-Length, which is -1 when chunked.
         · The proxy bypass list went into a quoted Chromium argument unescaped.
         · shared-db-schema.sql's DROP TABLE ... CASCADE lines are commented out. The portal has owned
           these tables since 10.0; the file is a description now, and a README note saying "do not
           run this" is not a safeguard when the hazard is one paste from a file named like that. -->
    <!-- 10.19.0 makes finding the application form a loop instead of a guess.

         The generic adapter was one shot: click the first control whose text is exactly "apply" or
         whose id/class contains the word, then count fillable controls and give up below three.
         That describes one shape of careers page and none of the others. The button often says
         "I'm interested" or "Join our team". The description and the form are frequently two tabs
         of one page, so the form is present but unpainted and the count is of the wrong panel. And
         a posting page may genuinely have no form, the application being one or two navigations
         further on. Deel failed this way seven times, reporting "1 control" each time — true of the
         page it was standing on, silent about the one it should have gone to.

         AgenticApplyNavigator replaces it with survey → score → act → re-survey, bounded at four
         hops. The page reports its own tabs, its fillable controls and every clickable thing on it;
         each candidate is scored on apply wording, href and attributes, with structural shape as a
         tie-breaker only — a bonus for looking like a button cannot qualify a candidate that has no
         apply signal, or a job index offers up its first job title and the run wanders to a
         different job. Unselected tabs are searched before any navigation, since a form already on
         the page beats a page change that may not come back. Candidates are addressed by a
         data-ds-nav stamp the survey writes, so a re-render invalidates the reference instead of
         silently matching whatever drifted into that position. Every hop is traced with the score
         and the reasons behind it, and a dead end names the page and what was tried rather than
         repeating the control count.

         Submit/next/continue wording is scored to -100 and never clicked: this loop looks for the
         way in and must never become the thing that presses send.

         Description gathering follows the same page. Tabs are opened one at a time and their panels
         appended to the description, so a posting that splits Overview / Responsibilities /
         Benefits across a strip reaches ChatGPT whole instead of as whichever panel happened to be
         painted; panels carrying form controls are skipped, since an Application tab is a form and
         its field labels are the noise the structural description test exists to exclude. The
         originally selected tab is restored afterwards.

         Verified against DOM fixtures driving the shipped scripts: "I'm interested" chosen over
         "Save this job" and "Sign in"; a three-tab posting enumerated with the form found on the
         unselected Application tab after activation; "Submit application" never offered as a way
         in; a job index yielding no candidate at all; a real Apply link outranking "Join our team";
         a short button beating a long prose link containing the word apply; a stale stamp reported
         rather than mis-clicked; panel reads scoped to their own tab; hidden controls excluded. -->
    <!-- 10.20.0 adds the manual bid: you fill the form, the app writes the resume beside you.

         Greenhouse, Lever and Ashby apply correctly on their own. Everything else is a board with
         no adapter, where hunting for the form is a guess and filling it is a worse one. This is
         the other way round for those, and it is a deliberate stopgap until the generic adapter is
         finished — not a fallback the app falls into, but a mode chosen per link.

         Pick a link, press "Bid on the selected link by hand", and the app navigates to the posting
         and stops. No adapter is resolved, no form hunted for, nothing typed and nothing pressed.
         Copy the description across into the box, press start, and the resume is generated in the
         ChatGPT workspace while the form is filled in by the person looking at it — the minute of
         ChatGPT and the several minutes of typing overlap instead of queueing. When the resume
         lands it is offered, not attached: a controlled form can rerender when its file input
         changes, and doing that underneath somebody mid-field is how a half-filled application is
         lost. "I submitted this" records it, because the app cannot watch a page it is not driving.

         Mechanically it is a Background flag on ChatGptResumeRequest/ResumeAutomationResult that
         suppresses the workspace switching an automatic run relies on, plus a third intent
         (JobWorkItemIntents.Manual) and three statuses. Background is not ResumeOnly: ResumeOnly
         deliberately records no bid, and a manual bid is still a bid. Submission reuses
         CompleteSubmittedItemAsync, so a manual bid reaches the board by the same path as any
         other rather than a second dialect of it, and attaching reuses UploadResumeAsync, so the
         file-input scoring is identical in both modes.

         The manual statuses survive a restart, unlike the in-flight ones: those describe work a run
         was holding and nothing holds them afterwards, whereas this describes a decision about the
         link, and quietly requeueing it for automatic processing would undo that decision without
         saying so. The exception is ManualResumeRunning, whose generation died with the process —
         that drops back to ManualBid with the pasted description still on the item. A failed
         background resume likewise leaves the link open rather than marking it Failed: the form on
         screen is still filled in and still the person's.

         Verified: manual statuses distinct and absent from the InFlight set; ManualResumeRunning →
         ManualBid across a restart while ManualBid and ManualResumeReady survive; no manual status
         eligible for the automatic run; the panel headline following each state transition. -->
    <!-- 10.21.0 gives each lane its own ChatGPT browser, and adds the account management centre.

         A manual bid exists so the typing and the generating overlap, and an automatic run wants
         the composer at the same moment. One browser cannot serve both: the second request
         navigates the pane out from under the first, and the run that was waiting on a reply reads
         whatever the other one produced. So there are two Resume Studio workspaces now — same
         driver, different lane — reachable as "Resume Studio" and "Resume Studio · manual".

         The account is the browser profile folder, because that is where the cookies are: two
         browsers on one folder are one signed-in user, two on different folders are two.
         ChatGptAccountService manages that — add, rename (the folder never moves, moving it would
         sign the account out), remove (the folder is left on disk), and assign a lane to an
         account. The seeded Default adopts the pre-10.21 folder, so upgrading signs nobody out.

         Separate accounts means the lanes cannot interfere at all. One account shared means they
         still run at once but share a conversation list, and that is the part that needed real
         work: the remembered chat was keyed on profile id alone, so both lanes read the same URL
         at startup and both continued it — two jobs' descriptions interleaved into one thread, each
         reading the other's reply as its own, and nothing about the result looking wrong. The key
         is now profile-and-lane, and ChatGptConversationRegistry arbitrates the case that key
         cannot cover: the same id reaching both lanes anyway, via ChatGPT's own sidebar or a
         hand-edited settings file. First claim wins; the loser starts a fresh chat, which costs one
         profile prompt and is always safe.

         The decision is read synchronously from settings already in memory, because it is needed on
         the UI thread inside the synchronous request builder and blocking there on the claim — a
         chain that saves to disk — is a deadlock waiting for a slow write. The asynchronous claim
         follows and records it; a race costs a fresh chat, never a shared one.

         Two WebView2 controls may share a user-data folder only through the same environment
         object, so environments are cached per (folder, arguments) — building a second one over the
         same directory is a lock conflict, and that is the ordinary case whenever both lanes are on
         one account. /dev registers the manual browser as "chatgpt-manual" rather than letting the
         two overwrite each other under one name.

         Verified against the shipped statics: lane-scoped session keys differing from each other,
         from other profiles, and from the bare profile id that both lanes used to share; an
         unclaimed or self-owned conversation allowed and the other lane refused; the same id under
         a different account never colliding; pruning dropping a lane's abandoned claims while
         leaving the other lane's and other accounts' alone. That last test caught a real bug —
         the prune matched the kept slot by EndsWith("|" + id), which spares any claim whose id ends
         with the kept one, so keeping "abc" would also keep "xyzabc". It compares whole keys now. -->
    <!-- 10.22.0 turns manual bids into a board, and gives the automatic run somewhere to hand off to.

         The 10.20 manual bid was one open bid at a time, which saves almost nothing: the only thing
         overlapping is that single resume with that single form, about a minute. So it is a board
         now — several bids at once, each with its own tab and its own form, their resumes written
         one after another behind them. You are never waiting on ChatGPT; you are filling the next
         form while it works. ManualBoard is a view over JobQueue filtered on Intent == Manual, so
         persistence, restart recovery and status handling are the queue's and are not duplicated.

         Generation is serial per lane and the board is what makes that legible — you can see which
         resume is being written and which are waiting. Queueing one does not need its form open: a
         description is all a resume needs, so several can be lined up and then worked through.
         Manual bids no longer wait on the automatic run either. Each gets a tab marked
         IsAutomation = false, which is deliberately not OpenAutomationTabAsync — that one makes its
         browser the automation browser, which is what every script targets. So a run keeps driving
         its own tab while a person fills another, and with two ChatGPT lanes each has a resume in
         flight at once.

         And the flow between them: a Link-scoped failure — the posting is what the automation
         cannot do, an unreadable description, a form no adapter matches, a page behind a human gate
         — now moves the link to the manual board instead of a Failed list. That list was a pile
         rather than a queue: nothing worked through it, and the postings in it were usually fine and
         just needed a person. Whatever the run already got comes across, so a link that failed at
         opening the form arrives with its description already read and its resume one button away.
         Machinery failures still stop at Failed and stay retryable: ChatGPT signed out or Word
         unavailable breaks the manual lane in exactly the same way, so handing it over would hand
         over the problem too.

         One bug worth naming: UploadResumeAsync attached through JobSiteBrowser, which is the
         automation browser. With several tabs open, attaching a manual bid's resume would have put
         it into whatever form the run was driving at that moment. It takes an explicit target now.

         Verified against the shipped source: the routing wired as described (machinery → Failed,
         link → board), the handoff keeping the job description, closing the automation tab and
         opening no new one, no manual status eligible for the automatic run, and a moved link
         staying moved across a restart rather than quietly rejoining the queue. -->
    <!-- 10.22.1 fixes a lane mix-up found by running the app rather than reasoning about it.

         Both Resume Studio workspaces read their lane off the view-model to decide which ChatGPT
         account to sign in as, and at startup Loaded fires before the DataContext binding reaches
         the child views — so both read null, both defaulted to Auto, both opened the automatic
         lane's browser profile, and both registered with /dev under the name "chatgpt", the second
         silently replacing the first. Two browsers, one identity, and the per-lane account
         assignment in Settings quietly doing nothing at all.

         A workspace cannot start before it knows which lane it is, because the lane picks the
         folder. It now declines to guess and waits for DataContextChanged. Verified live:
         /dev/browsers lists chatgpt and chatgpt-manual separately, each logging its own lane.

         Also: an init failure only reached StatusMessage, which is invisible on a workspace
         designed never to be shown — a manual lane whose browser never started would have queued
         every resume behind it in silence. It logs to Activity now.

         And /dev/command gains fail-link and fail-machinery, which drive the real
         MarkAutomationFailureAsync so the handoff to the manual board can be exercised without
         applying to anybody's posting. -->
    <!-- 10.23.0 lets the automatic queue run without taking the screen.

         Every stage of a run brought its workspace to the front — Resume Studio while ChatGPT
         writes, the Job Browser when a form is filled. That is right when you are watching a run
         and intolerable when you are not, because it moves the page out from under you every time
         the queue changes stage, which is exactly what a manual bid is trying to work through.

         The old comment justified the switching partly on throttling: "the stage that is actually
         driving a page belongs on screen: it runs unthrottled". Measured on the running app rather
         than argued about — a hidden WebView2 keeps a real viewport (590x625, not 0x0) and its
         timers run at full rate: 131 of 132 expected ticks over six seconds, against 132 for a
         visible one. Only requestAnimationFrame stops, 0 frames against 397. That is animation,
         not logic, and the run reads pages by script from outside rather than by anything the page
         schedules for itself. So the switching is a preference, and now a setting.

         Run-driven handoffs go through ShowForRun, which honours it and reads it per call so a
         toggle takes effect on the next stage rather than the next restart. Person-driven ones
         still switch unconditionally: a button that silently does nothing is a broken button.
         Default on, since not being interrupted is the point.

         What it costs, and the setting says so: a finished application no longer puts itself in
         front of you. It parks in its tab as it already did, and the review count is where you see
         it waiting. /dev/state reports the flag. -->
    <!-- 10.24.0 splits bidding into two tabs, because it is two jobs.

         Manual bids were a board inside the Job Browser, which made that tab answer to both an
         automatic run and a person filling a form by hand. They are separate work: a run is a
         machine driving a form with a person reviewing, a manual bid is a person driving the form
         with the machine writing a resume. Two sidebar tabs now, different UI in each.

         Manual Bids owns its own browser — its own environment and user-data folder, not the Job
         Browser's tab pool — so an automatic run parking a review never competes with a form being
         filled, and neither waits on the other for a slot. ManualTabReserve goes with it.

         They run at the same time, which is the point, and the reason that holds is worth writing
         down: the run drives pages through DevTools Input events addressed to its own CoreWebView2,
         not the OS input queue. It takes no focus and cannot type into anything else. The only
         thing in the app that does use global SendInput is /refresh-word, the deleted extension's
         endpoint, which is not a stage of any run. What the two flows genuinely share is Word —
         one warm instance on one COM thread, so two macros queue — and both spend minutes with a
         person in a form, which is what keeps that from being felt.

         The lists are separate too. ManualBidStore owns the manual one and is the seam a failed
         link crosses: the Job Browser hands a posting-level failure over and drops it, the Manual
         Bids tab is listening. Neither view-model references the other. Whatever the run got comes
         across — most fail at opening the form, which is after the description was read, so a row
         usually arrives with its job description already in place.

         Verified on the running app: a Link-scope failure moves a link out of the automatic queue
         and into the manual list (7 -> 6, 0 -> 1); a link carrying a 7,411-character description
         arrives with it intact; no link appears in both lists; five moved rows survive a restart
         while the automatic queue keeps only its own two; no duplicate rows; no startup errors. -->
    <!-- 10.25.0 groups the queue by job board, and moves links by the group.

         A flat list of thirty URLs says nothing about which of them the automation can do. The
         board does: every posting on one site is the same form behind the same adapter, so they
         succeed together and they fail together. The queue is grouped by board now, with the count
         in the heading, and each group carries one action - move all of these to Manual Bidding.

         That rule holds on the failure path too, and more strongly there. A posting-level failure
         on one link is not a fact about the link, it is a fact about the board; leaving its five
         siblings queued spends five more runs rediscovering it, which is the waste the hand-off
         exists to stop. So a Link-scope failure now takes the whole group across. The manual
         button is a guess about a board; this one already failed on it.

         Also: the manual-and-recovery panel is gone, Job Browser is now "Auto bidding" and Manual
         Bids is "Manual Bidding", and the site-selection chips are replaced by the grouping they
         were approximating. The flat grid stays, collapsed, because links that are no longer
         queued still need somewhere to be read.

         One dead binding removed with them: the by-hand button still bound StartManualBidCommand,
         which was deleted when the board moved out of this tab in 10.24. XAML binding failures are
         silent at runtime, so it had been doing nothing at all.

         Verified live on seven real links: six groups, with deel.com correctly collapsing to one
         group of two; failing one deel link moved both to Manual Bidding and left the other five
         boards alone; no startup errors. -->
    <!-- 10.25.1 moves the two ChatGPT workspaces to the bottom of the sidebar.

         They are machinery rather than places work gets done: you go there to sign in, and
         occasionally to watch. Under a CHATGPT heading at the bottom, beside ACCOUNT, they stop
         competing with the tabs that are actually the work.

         Full size, deliberately. The alternative considered was a small view docked in a corner of
         the bidding tabs, and it would break generation: a WebView2's viewport drives page layout,
         so ChatGPT in a corner widget renders its narrow layout - a different DOM, with a composer
         the scripts in ChatGptComposer were not written against. Signing in needs the room too,
         password and 2FA and whatever challenge follows. Demoted, not shrunk.

         Labelled "Auto lane" and "Manual lane" under that heading, which says what they serve
         rather than repeating the workspace's own name twice.

         Auto bidding also now sits above Manual Bidding in the workspace list, matching the order
         the work actually happens in.

         Verified live: both lanes still register and initialise - /dev/browsers lists chatgpt and
         chatgpt-manual ready - and no startup errors. -->
    <Version>10.25.1</Version>
    <RootNamespace>DevStrider.Desktop</RootNamespace>
  </PropertyGroup>

  <!-- Bundle the .ico so Window.Icon can load it at runtime (and Explorer can pick it
       up from the .exe via ApplicationIcon above). -->
  <ItemGroup>
    <Resource Include="Assets\DevStrider.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms=true auto-adds System.Windows.Forms to the implicit usings, which
    collides with System.Windows.* (Application / UserControl / MouseEventArgs / â€¦) in
    every WPF code-behind. Opt this single namespace out; TrayService.cs imports
    it explicitly with the aliases it needs.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No database driver, and no crypto library.

      Npgsql went with the direct connection to the portal's PostgreSQL: this app holds no
      database credential any more and issues no SQL. It calls /api/devstrider/* over HTTP with a
      bearer token, and HttpClient is in the box.

      BouncyCastle went with it. It was here for one thing - scrypt, so this app could verify
      app_user.password_hash itself. That was a second implementation of the portal's
      authentication rule, in a different language, on every laptop, with nothing keeping the two
      in step. The portal checks passwords now, which is the only place that can.
    -->

    <!-- Cloudflare R2 speaks the S3 API, so the AWS SDK drives it directly: point it at
         https://<account>.r2.cloudflarestorage.com with region "auto" and path-style
         addressing. Hand-rolling SigV4 would be a lot of security-critical code for no gain. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.416.4" />

    <!-- DI container only â€” Hosting/Config/Logging aren't used in the WPF process. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />

    <!-- Charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />

    <!-- MVVM helpers -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Embedded Chromium surface for the deliberately user-driven ChatGPT workspace. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

